// Run with MapgenReviewTests.cjs after loading this checkout's scripts.
local check=@(ok,message){if(!ok)throw Exception(message);};
local generator=MapGenerator();
generator.gendef={props:[{pid:"integer",q:1},{pid:"continuous",q:0.1}]};
generator.rnd=Random(4242,11);
local seen={},fraction=false;
for(local i=0;i<512;i++){
    local value=generator.getargrange("integer",[0.0,4.0]);
    check(value>=0&&value<=4&&value==Math.ifloor(value),"Integer range produced a fraction or escaped its bounds");
    seen[value]<-true;
    local continuous=generator.getargrange("continuous",[0.0,1.0]);
    fraction|=continuous>0&&continuous<1;
}
check(length(seen)==5,"Integer range excluded an endpoint");
check(fraction,"Continuous range lost fractional values");
check(generator.getargrange("integer",[3.0,3.0])==3,"Fixed integer range changed");
local numeric={};
generator.parseopts({integer:[4.0,0.0]},[],numeric);
check(numeric.integer==Math.ifloor(numeric.integer)&&numeric.integer>=0&&numeric.integer<=4,"parseopts bypassed integer range sampling");
foreach(def in ::MapGenerators)if(def.val=="castle"||def.val=="town"||def.val=="village"){
    local size=def.props.find(@(p)p.pid=="size");
    check(size.range[0]==(def.val=="castle"?128:64),"Settlement size control has an invalid lower bound");
}

// Bind the real methods to fake controls; native windows are not needed here.
local calls={undo:0,redo:0};
local dialog={busy:false,bw3d:null,selpic:null,refresh=@(){},updateUndoable=@(){},
    op:{undo=@(){calls.undo++;},redo=@(){calls.redo++;}}};
dialog.setBusy<-MapGenDialog.setBusy.bindenv(dialog);
dialog.execMenu<-MapGenDialog.execMenu.bindenv(dialog);
local controls={};
foreach(name in ["btn_gen","typemenu","listmenu","btn_close","btn_apply","btn_copy"])
    controls[name]<-{enabled:false,setEnabled=function(value){enabled=value;}};
dialog.view<-{findChild=@(name)controls[name]};
dialog.proplist<-{listview:{setEnabled=@(value){}}};
dialog.blocklist<-{setEnabled=@(value){}};
dialog.piclist<-{setEnabled=@(value){}};
dialog.setBusy(true);
dialog.execMenu({uid:"menu_edit_undo"});
dialog.execMenu({uid:"menu_edit_redo"});
check(calls.undo==0&&calls.redo==0,"Busy dialog ran keyboard undo/redo");
check(!controls.btn_apply.enabled&&!controls.btn_copy.enabled,"Busy dialog enabled apply/copy");
dialog.bw3d={};
dialog.selpic=null;
dialog.setBusy(false);
check(controls.btn_apply.enabled&&controls.btn_copy.enabled,"Retained preview became unusable after regenerating thumbnails");
dialog.execMenu({uid:"menu_edit_undo"});
dialog.execMenu({uid:"menu_edit_redo"});
check(calls.undo==1&&calls.redo==1,"Idle dialog lost undo/redo");
dialog.bw3d=null;
dialog.setBusy(false);
check(!controls.btn_apply.enabled&&!controls.btn_copy.enabled,"Empty preview enabled apply/copy");

// Keep native generation out of this test while exercising the actual candidate setup.
local root=getroottable(),originalGenerator=root.MapGenerator;
root.MapGenerator=@(){return {srcw:0,srcd:0,seed:0,gendef:null,gendata:null,blkmap:null,tmpdir:null,src:null,generateSourceImage=@(parameters){}};};
local paletteDialog={type:"village",gendata:{size:[160,160]},blkmap:{[0]:7}};
local candidate=MapGenDialog.execMapgen.bindenv(paletteDialog)("tmp",4242);
root.MapGenerator=originalGenerator;
paletteDialog.blkmap[0]=8;
paletteDialog.gendata.size[0]=200;
check(candidate.mapgen.blkmap[0]==8,"Unbuilt candidate retained a stale block palette");
check(candidate.mapgen.gendata.size[0]==160,"Candidate generation settings were not snapshotted");
local wallGenerator=MapGenerator();
wallGenerator.gendata={baseyprop:[3,3]};
wallGenerator.rnd=Random(4242,11);
wallGenerator.settlementWallHeight=0;
local biomes=RGBAImage(3,1);
biomes[0]=0;
biomes[1]=3;
biomes[2]=4;
wallGenerator.gendef=::MapGenerators.find(@(v)v.val=="castle");
wallGenerator.blkmap=wallGenerator.gendef.blkmap;
local heights=wallGenerator.generateBlockHeightImage(biomes);
check((heights[0]>>>16)==3&&(heights[1]>>>16)==9&&(heights[2]>>>16)==9,"Open castle lost its keep walls");
wallGenerator.settlementWallHeight=1;
wallGenerator.assetPlan={castleDefenseMask:[0,2,0],regions:[{kind:"keep",x0:2,x1:2,y0:0,y1:0},{kind:"castle_portal",objectHeight:8}]};
heights=wallGenerator.generateBlockHeightImage(biomes);
check((heights[1]>>>16)==4&&(heights[2]>>>16)==11,"Keep and curtain heights were not independent");
local castlePalette=wallGenerator.gendef.blkmaplist;
check(castlePalette.len()%3==0 && castlePalette[castlePalette.len()-1]==null,"Castle palette leaves stale controls");
local tabState={selected:-1};
tabState.busy<-true;
tabState.setTab<-function(value){selected=value;};
local tabAction=MapGenDialog.actionevent.bindenv(tabState);
tabAction({src:{name:"LIST"},actioncmd:1});
check(tabState.selected==1,"Busy tab highlight and panel fell out of sync");

local squareDoor={x:1,y:0,z:0,rot:1,br:IRect3D(0,0,0,2,4,2),isClass=@(name) name=="door"};
local squareAsset={w:12,h:8,d:12,collectFreeBlocks=@(bounds,output){return [squareDoor];}};
local findDoor=MapGenerator.constructionAssetDoor.bindenv(squareAsset);
check(findDoor(squareAsset).side==3,"Square door used the adjacent wall axis");

local vegetationImage=RGBAImage(20,20), vegetationBiomes=[];
for( local i=0;i<400;i++){
	vegetationImage[i]=3<<16;
	vegetationBiomes.push(17);
}
local vegetationWorld=BlockWorld(20,32,20);
local vegetation={
	gendef:{settlement:true}, dst:vegetationImage, rnd:Random(4242,11),
	assetPlan:{regions:[],biomes:vegetationBiomes,settlementSite:"oasis",countryWealth:1,seed:4242},
	assetParameters:{naturalDecorationDensity:0}, saveDiagnostic=@(name,data){}
};
MapGenerator.decorateSettlement.bindenv(vegetation)(vegetationWorld);
local palms=vegetationWorld.collectFreeBlocks(IRect3D(0,0,0,20,32,20),[]);
check(palms.len()>0,"Oasis grove was empty at zero scatter density");
foreach( palm in palms) check((palm.fbparam&0x3ff)==68,"Oasis grove contains a non-palm object");
return {passed:true,integerValues:length(seen),continuousFraction:fraction,keyboardUndoRedo:true,retainedPreview:true,settlementSize:true,sharedPalette:true,openCastleWalls:true};
