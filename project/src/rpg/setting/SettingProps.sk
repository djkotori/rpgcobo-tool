local destprop = { pid="dest", lbl = "$T.cmd_mapmove_dest", type=PORTAL, cnt="cnt6v.ui" };
local exitmappropdef = {
	name = "$T.setting_exitmap"
	props = @( v){
		local a = [
			{ pid="enabled", lbl="$T.lbl_enabled", type=BOOL, refresh=true,
				get = @( prop, data) !!data["dest"],
				set = @( prop, data, val){
					local m = ::conf.setting.inimap, p = m.pos;
					data.dest <- val ? { mapid=m.mapid, pos=p } : null;
				}
			},
		];
		if( v["dest"]) a .. destprop
		return a;
	}
	tostring = @( v){
		if( !v["dest"]){
			return "$T.lbl_notset";
		}else{
			return getPropertyText( destprop, v);
		}
	}
}

stageprops .. {
	mapedit=true, pid="exitmap", lbl="$T.setting_exitmap", type=PROPERTYLIST,
	propdef = exitmappropdef,
	defval = {dest=null},
}

stageprops .. {
	pid = "mapexitable",
	lbl = "$T.setting_mapexitable",
	type = BOOL,
	defval = true,
};

stageprops .. {
	mapedit=true, pid="canenter_water", lbl="$T.setting_canenter_water", type=BOOL//1, cnt="cnt5.ui",
	defval = false,
	
	func = @( stage, val){
		local bci = stage.bwcol.ref, t = stage.stat.statmap;
		local b = 1 | (t["canenter_water"]?0:2) | (t["canenter_hole"]?0:4);
		bci.setFinMode( b);		//	barrior | water | hole
	}
}

stageprops .. {
	mapedit=true, pid="canenter_hole", lbl="$T.setting_canenter_hole", type=BOOL//1, cnt="cnt5.ui",
	defval = false,
	
	func = @( stage, val){
		local bci = stage.bwcol.ref, t = stage.stat.statmap;
		local b = 1 | (t["canenter_water"]?0:2) | (t["canenter_hole"]?0:4);
		bci.setFinMode( b);		//	barrior | water | hole
	}
}

