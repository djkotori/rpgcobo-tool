stageprops .. {
	mapedit=true,
	pid="weather",
	lbl="$T.setting_weather",
	type = PROPERTYLIST,
	propdef = weatherpropdef,
	defval = {type=null},

	func = @( stage, val){
		stage.view3d.renderer.fadeWeather( val, 500);
	}
};

