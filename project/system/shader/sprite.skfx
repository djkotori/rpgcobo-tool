declare sprite;

module mod_math;

//	一般的なスプライト描画
//	def : 普通に描画
//	strokefont : ストローク付きのフォント
//	

param common
{
	attribute highp vec4 in_pos <ID=POSITION>;
	attribute highp vec4 in_uv <id=UV1>;
	attribute lowp vec4 in_col <id=COLOR1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	
	uniform mediump mat4 colormat <id=COLORMAT>;
	uniform mediump mat4 p1 <id=MISC1MAT>;
	
	varying highp vec4 v_uv;
	varying lowp vec4 v_col;
	
	fragout lowp vec4 fragcolor;
}

vs def
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv;
		v_col = in_col;
	}
}

//////////////////////////////////////////////////////////////////////
//	default sprite shader

fs def
{
	void main(){
		lowp vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		fragcolor = pix;
	}
}

technique def
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = def;
	}
}

//////////////////////////////////////////////////////////////////////
//	sRGB draw

fs srgb
{
	void main(){
		lowp vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		pix.xyz = toSRGB( pix.xyz);
		fragcolor = pix;
	}
}

technique srgb
{
	pass {
		CULLFACE = OFF;
		using colorspace;
		
		param = common;
		vs = def;
		fs = srgb;
	}
}


//////////////////////////////////////////////////////////////////////
//	stroke shader

param strokefont
{
	// uniform lowp vec4 subcolor <id=UNICOLOR1>;
	uniform mediump mat4 p1 <id=MISC1MAT>;
}

fs strokefont
{
	void main(){
		vec4 pix;
		$(COLORTEX1) { 
			vec4 p = texture2D( coltex1 , v_uv.xy);
			float w = clamp( dot( v_uv.zw*2.0-1.0, p1[2].xy)*0.5 + 0.5, 0.0, 1.0) * p1[2].z;
			pix = p.x * mix( v_col, p1[1], w) + p.y * p1[0];
		} : { 
			pix = v_col;
		}
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		fragcolor = pix;
	}
}

technique strokefont
{
	pass {
		using common;
		CULLFACE = OFF;
		
		param = strokefont;
		vs = def;
		fs = strokefont;
	}
}

//////////////////////////////////////////////////////////////////////
//	high precision sprite shader ( api >= 30 )

param hp
{
	attribute highp vec4 in_pos <ID=POSITION>;
	attribute highp vec4 in_uv <id=UV1>;
	attribute mediump vec4 in_col <id=COLOR1>;
	
	uniform mediump sampler2D coltex1 <id=COLORTEX1>;
	uniform mediump sampler2D coltex2 <id=COLORTEX2>;
	uniform highp vec2 coltex1scale <id=COLORTEX1_PIX>;
	
	uniform mediump mat4 colormat <id=COLORMAT>;
	uniform mediump mat4 p1 <id=MISC1MAT>;
	
	varying highp vec4 v_uv;
	varying mediump vec4 v_col;
	
	fragout mediump vec4 fragcolor;
}

fs hp
{
	void main(){
		mediump vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		fragcolor = pix;
	}
}

technique hp
{
	pass {
		CULLFACE = OFF;
		param = hp;
		vs = def;
		fs = hp;
	}
}

//////////////////////////////////////////////////////////////////////
//	projection -> view z

fs ptovz
{
	void main(){
		highp float zw = $(COLORTEX1) { vec2( texture( coltex1 , v_uv.xy+p1[1].xy).x*2.0-1.0, 1.0); } : { vec2( 1.0); }
		highp float z = dot( zw, p1[0].xy);
		highp float w = dot( zw, p1[0].zw);
		fragcolor = vec4( p.z / p.w);
	}
}

technique ptovz
{
	apilevel = 30;
	
	pass {
		CULLFACE = OFF;
		param = hp;
		vs = def;
		fs = ptovz;
	}
}


//////////////////////////////////////////////////////////////////////
//	simple copy

param copy
{
	attribute highp vec4 in_pos <ID=POSITION>;
	attribute highp vec4 in_uv <id=UV1>;
	
	uniform highp sampler2D coltex1 <id=COLORTEX1, WRAP_S=CLAMP, WRAP_T=CLAMP>;
	uniform highp mat4 col <id=MISC1MAT>;
	varying highp vec4 v_uv;
	
	fragout highp vec4 fragcolor;
}

vs copy
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv;
	}
}

fs copy
{
	void main(){
		highp vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy); } : { col[0]; }
		fragcolor = pix;
		gl_FragDepth = pix.x;
	}
}

technique copy
{
	pass {
		CULLFACE = OFF;
		
		param = copy;
		vs = copy;
		fs = copy;
	}
}

//////////////////////////////////////////////////////////////////////
//	equirectangular to cubemap

param eqtocube
{
	attribute highp vec4 in_pos <ID=POSITION>;
	attribute highp vec4 in_uv <id=UV1>;
	
	uniform highp sampler2D coltex1 <id=COLORTEX1, MIN_FILTER=LINEAR, MAG_FILTER=LINEAR, WRAP_S=WRAP, WRAP_T=CLAMP>;
	uniform highp mat4 facemat <id=MISC1MAT>;
	varying highp vec4 v_uv;
	
	fragout highp vec4 fragcolor;
}

vs eqtocube
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv;
	}
}

fs eqtocube
{
	const highp float PI = 3.14159265;
	
	highp vec2 uvconv( highp vec2 cubeuv){
		highp vec3 n = normalize( (facemat * vec4( cubeuv*2.0-1.0, 1.0, 0.0)).xyz);
		highp float theta = atan( n.x, n.z);
		return vec2( theta / (2.0 * PI) + 0.5, acos( clamp( n.y, -1.0, 1.0)) / PI);
	}

	void main(){
		highp vec2 equv = uvconv( v_uv.xy);
		highp vec4 pix = texture2D( coltex1 , equv);
		fragcolor = pix;
	}
}

technique eqtocube
{
	pass {
		CULLFACE = OFF;
		
		param = eqtocube;
		vs = eqtocube;
		fs = eqtocube;
	}
}

//////////////////////////////////////////////////////////////////////
//	HDR RGB => RGBE

fs torgbe
{
	void main(){
		highp vec3 hdr = texture2D( coltex1 , v_uv.xy).rgb;
		highp float v = max( max( hdr.r, hdr.g), hdr.b);
		if (v < 1e-32) {
			fragcolor = vec4( 0.0);
		} else {
			highp float e = floor( log2( v)) + 1.0;
			highp vec3 rgb = floor( hdr * exp2( -e) * 256.0);
			fragcolor = vec4( rgb, e + 128.0) / 255.0;
		}
	}
}

technique torgbe
{
	pass {
		CULLFACE = OFF;
		
		param = hp;
		vs = def;
		fs = torgbe;
	}
}



//////////////////////////////////////////////////////////////////////
//	make diffuse SphericalHarmonics cubemap face (irradiance / PI)

param buildsh
{
	attribute highp vec4 in_pos <ID=POSITION>;	//	clip-space rectangle

	//	Linear HDR radiance; use level 0, not specular-prefiltered mipmaps.
	uniform highp samplerCube coltex1 <id=COLORTEX1, MIN_FILTER=LINEAR, MAG_FILTER=LINEAR, WRAP_S=CLAMP, WRAP_T=CLAMP, WRAP_R=CLAMP>;
	uniform highp mat4 p1 <id=MISC1MAT>;	//	p1[0].x: face index (+x,-x,+y,-y,+z,-z)

	varying highp vec3 v_n;

	fragout highp vec4 fragcolor;

	const highp mat3 rotmat[6] = mat3[6](
		mat3( 0,0,-1, 0,1,0, 1,0,0),
		mat3( 0,0,1, 0,1,0, -1,0,0),
		mat3( 1,0,0, 0,0,-1, 0,1,0),
		mat3( 1,0,0, 0,0,1, 0,-1,0),
		mat3( 1,0,0, 0,1,0, 0,0,1),
		mat3( -1,0,0, 0,1,0, 0,0,-1)
	);
}

vs buildsh
{
	void main(){
		int f = int( p1[0].x);
		//	Normalize after interpolation so the two triangles share the same projection.
		v_n = rotmat[f] * vec3( in_pos.x, -in_pos.y, 1.0);
		gl_Position = vec4( in_pos.xy, 0.0, 1.0);
	}
}

/*
highp float shWindow(highp float band, highp float cutoff){
    if( band >= cutoff) return 0.0;
    highp float x = 3.14159265359 * band / cutoff;
    highp float s = sin( x) / x;
    return s * s * s * s;
}

// cutoff: cmgen の -w と同じ、正の数値
highp float w1 = shWindow( 1.0, cutoff);
highp float w2 = shWindow( 2.0, cutoff);

highp float kernel =
    1.0
    + 2.0 * w1 * cosine
    + 0.625 * w2 * (3.0 * cosine * cosine - 1.0);

//	current setting
cutoff = 3.751877 
*/

fs buildsh
{
	void main(){
		highp vec3 pix = vec3( 0.0);
		highp vec3 n = normalize( v_n);
		highp float weightSum = 0.0;
		int size = min( textureSize( coltex1, 0).x, 16);
		for( int f = 0; f < 6; ++f){
			for( int y = 0; y < size; ++y){
				for( int x = 0; x < size; ++x){
					highp vec2 uv = (vec2( float(x), float(y)) + 0.5) * (2.0 / float(size)) - 1.0;
					highp vec3 d = normalize( rotmat[f] * vec3( uv.x, -uv.y, 1.0));
					highp float r2 = 1.0 + dot( uv, uv);
					highp float weight = 1.0 / (r2 * sqrt( r2));
					highp float cosine = dot( n, d);
					//	SH addition theorem: bands 0,1,2 with Lambert factors 1,2/3,1/4.
					//	This is projection + evaluation of all nine real SH terms, including 1/PI.
					// highp float kernel = 1.0 + 2.0 * cosine + 0.625 * (3.0 * cosine * cosine - 1.0);
					highp float kernel = 1.0 + 2.0 * 0.61948796 * cosine + 0.625 * 0.12441843 * (3.0 * cosine * cosine - 1.0);
					pix += textureLod( coltex1, d, 0.0).rgb * (weight * kernel);
					weightSum += weight;
				}
			}
		}
		fragcolor = vec4( max( pix / weightSum, 0.0), 1.0);
	}
}

technique buildsh
{
	apilevel = 30;

	pass {
		CULLFACE = OFF;

		param = buildsh;
		vs = buildsh;
		fs = buildsh;
	}
}
