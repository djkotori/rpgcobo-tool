declare weather;

module mod_math;

param def
{
	attribute mediump vec4 in_pos <ID=POSITION>;
	attribute mediump vec4 in_uv <id=UV1>;
	
	uniform lowp sampler2D coltex <id=COLORTEX1, MIN_FILTER=LINEAR, MAG_FILTER=LINEAR, WRAP_S=WRAP, WRAP_T=WRAP>;
	uniform sampler3D n3tex <id=COLORTEX2, MIN_FILTER=LINEAR, MAG_FILTER=LINEAR>;
	uniform highp usampler2D uztex <id=DEPTHTEX, WRAP_S=CLAMP, WRAP_T=CLAMP, MIN_FILTER=NEAREST, MAG_FILTER=NEAREST>;
	
	uniform highp mat4 invpmat <id=ENV2MAT>;
	uniform highp mat4 invvmat <id=ENV3MAT>;
	uniform highp mat4 vmat <id=VMAT>;
	uniform highp mat4 P <id=MISC1MAT>;
	
	varying highp vec2 v_uv;
	
	fragout mediump vec4 fragcolor;
}

vs def
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv.xy;
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	
//	Rain
//	
//	time, length, width, angle
//	density, 
//	raincolor
//	

param rainparam
{
	flat varying highp vec4 v_rot;
}

vs rain
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv.xy;
		//
		float xdens = P[1].x;
		float r = P[0].w;
		float ca = cos( r), sa = sin( r);
		v_rot = vec4( ca *xdens, -sa*0.5, sa * xdens, ca*0.5);
	}
}

fs rain
{
	highp float hash( highp vec2 p) {
		return fract( sin( dot( p, vec2( 41.0, 289.0))) * 45758.5453);
	}

	// 雨粒の形状
	float raindrop( highp vec2 uv, highp float time) {
		vec2 id = floor( uv);
		vec2 gv = fract( uv) - 0.5;   // グリッド内座標
		float n = hash( id);
		float t = time * (0.8 + n) + n * 10.0;
		float tn = fract( floor( t) * 13.4);
		gv.x += (tn - 0.5) * 0.6;
		gv.y += 1.0-fract( t) - 0.5;
		gv = smoothstep( P[0].yz, vec2( 0.0), abs( gv));
		return gv.x * gv.y;// + (fract( uv).y - 0.5 > 0.49 ? 1.0 : 0.0);	//	test
	//	return smoothstep( P[0].y, 0.0, abs(gv.x)) * smoothstep( P[0].z, 0.0, abs(gv.y));
	}
	
	void main(){
		const vec2 offs0 = vec2( -0.2), offs1 = vec2( 0.2, 0.5);
		vec4 pix = vec4( 0.0);
		float c = 0.0;
		vec2 duv = P[3].xy;
		highp vec2 uv = v_uv * 0.4 + offs0;
		// 雨の角度を回転行列で適用
		mat2 rot = mat2( v_rot);
		c += raindrop( rot * uv + offs1 -duv, P[0].x);
		rot = mat2( v_rot * vec4( 1.5, 1.9, 1.6, 1.8));
		c += raindrop( rot * uv + offs1 -duv*0.8, P[0].x*0.8) * 0.7;
		rot = mat2( v_rot * vec4( 2.7, 3.4, 2.3, 3.4));
		c += raindrop( rot * uv + offs1 -duv*0.6, P[0].x*0.6) * 0.5;
		rot = mat2( v_rot * vec4( 3.1, 4.6, 2.8, 4.4));
		c += raindrop( rot * uv + offs1 -duv*0.4, P[0].x*0.4) * 0.3;
		//
		pix = mix( pix, P[2], clamp( c, 0.0, 1.0));
		fragcolor = pix;
	}
}

technique rain
{
	apilevel = 30;

	pass {
		using rainparam;

		param = def;
		vs = rain;
		fs = rain;
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	
//	Mist
//	
//	time, length, width, angle
//	density, 
//	raincolor

fs mist
{
	float fbm( highp vec3 p) {
		return texture( n3tex, p).x;
	}

	float fbm3( highp vec3 p){
		p *= vec3( 128.0/256.0, 8.0/256.0, 128.0/256.0);
		float w = 0.54;
		float v = fbm( p) * w; w *= 0.5; p *= 2.0;
		v += fbm( p) * w; w *= 0.5; p *= 2.0;
		v += fbm( p) * w; w *= 0.5; p *= 2.0;
		v += fbm( p) * w;
		return v;
	}

	void main(){
		vec4 pix = vec4( 0.0);
		highp vec2 dxy = P[0].xy;
		highp float modif = P[0].z;
		highp vec2 uv = v_uv;
		vec2 duv = P[3].xy;
		highp float sc = P[1].y*0.002;
		highp vec2 p = uv * vec2(1.0, P[1].z)*sc - duv;
		p += dxy * 0.05;
		
		float n = fbm3( vec3( p.x, modif, p.y));

		// 霧の濃さ（下の方を濃くする）
		// float fogMask = smoothstep(0.3, 0.8, n);// * smoothstep(0.0, 0.6, uv.y);
		float thrs = 1.0-P[1].x*0.01;
		float fogMask = smoothstep(thrs-0.4, thrs+0.2, n);// * smoothstep(0.0, 0.6, uv.y);

		// 陰影を付ける（ノイズの勾配を利用）
		vec4 fogColor = mix( P[2]*vec4(0.6,0.6,0.6,1.0), P[2], fogMask);
		fogColor.xyz *= fogColor.w;

		// 背景とブレンド
		pix = mix( pix, fogColor, fogMask * 0.6);

		fragcolor = pix;
	}
}

technique mist
{
	apilevel = 30;

	pass {
		param = def;
		vs = def;
		fs = mist;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//	
//	Cloud
//	

fs cloud
{
	// 2D value noise
	// float vnoise( highp vec2 p) {
	// 	vec2 i = floor( p);
	// 	vec2 f = fract( p);
	// 	float a = fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.5453);
	// 	float b = fract(sin(dot(i + vec2(1.0, 0.0), vec2(127.1, 311.7))) * 43758.5453);
	// 	float c = fract(sin(dot(i + vec2(0.0, 1.0), vec2(127.1, 311.7))) * 43758.5453);
	// 	float d = fract(sin(dot(i + vec2(1.0, 1.0), vec2(127.1, 311.7))) * 43758.5453);
	// 	vec2 u = f*f*(3.0 - 2.0*f);
	// 	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
	// }

	// FBMで柔らかな雲影
	float fbm( highp vec2 p, highp float t) {
		// float amp = 0.5;
		// float sum = 0.0;
		// for( int i = 0; i < 3; i++) {
		// 	sum += amp * vnoise( p);
		// 	p *= 2.0;
		// 	amp *= 0.5;
		// }
		// return sum;
		return texture( coltex, p).x + texture( coltex, p*2.1-t*0.002).x*0.6 + texture( coltex, p*4.3+t*0.006).x*0.4;
		// return texture( coltex, p).x;
	}

	void main() {
		//	kari params
		highp float iTime = P[0].x;
		highp vec3 lightDir = normalize( vec3( -0.1, -1.0, 0.3));
		highp float cloudHeight = 100.0;
		highp vec2 windvec = P[0].zw;
		highp float cloudScale = P[1].x;
		vec3 cloudColor = P[2].xyz;
		vec2 shadowStep = P[1].zw;
		float ambientLift = 0.1;
		//	
		highp vec2 uv = v_uv;
		mediump uint uz = texture( uztex, uv).r;
		// スカイなどの無限遠（深度1.0近辺）は影処理を弱める
		if( uz >= 60000u) { fragcolor = vec4( 1.0); return; }
		// 画素ワールド座標
		highp vec3 wvp = (invvmat * vec4( reconstructWVP( uv*vec2(2.0,-2.0)+vec2(-1.0,1.0), uz, P[3]), 1.0)).xyz;
		// 光線方向に雲レイヤまでレイを飛ばして交点を取得
		highp float ldY = lightDir.y;
		// 光が水平に近い場合は投影が不安定になるのでガード
		// if( abs( ldY) < 0.05) {
		// 	ldY = sign( ldY) * 0.05;
		// }
		highp float t = (cloudHeight - wvp.y) / ldY;
		// 雲より上にある面は影がほぼ落ちない（t<0）
		// if( t <= 0.0) {
		// 	fragcolor = vec4( 1.0);
		// 	return;
		// }
		highp vec3 hitPos = wvp + lightDir * t;
		// 風で雲が流れるオフセット（ワールドXZ平面）
		highp vec2 flow = windvec * iTime;
		// 雲サンプリング座標（XZを使用）
		highp vec2 cloudUV = (hitPos.xz+flow) * cloudScale;

		// 雲マスク（0=快晴, 1=雲濃い）
		float cloudMask = fbm( cloudUV, iTime);
		// // ソフトさ調整：コントラストを落として淡く
		cloudMask = smoothstep( shadowStep.x, shadowStep.y, cloudMask);
		
		// 影係数作成（明部1.0 → 影へ減算）
		vec3 shadowed = mix( cloudColor, vec3( 1.0), cloudMask);

		// 影で完全に黒く潰れないよう持ち上げ
		// vec3 shadowed = vec3( 1.0 - shade) + ambientLift * shade;

		// わずかなカラーシフト（空気光の青み）
		// vec3 airTint = vec3(0.98, 0.99, 1.0);
		// shadowed *= mix( vec3(1.0), airTint, shade * 0.25);

		fragcolor = vec4( shadowed, 1.0);
	}
}

technique cloud
{
	apilevel = 30;

	pass {
		using reconstwvp;
		param = def;
		vs = def;
		fs = cloud;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//	
//	Snow
//	https://godotshaders.com/shader/multilayer-snowfall-shader/

fs snow
{
	vec3 generate_snowflake( vec2 coord, float layer_index, float time, float dens, float wind_strength) {
		float spread = 0.5;
		float size = 0.5;
		float speed = P[0].y * 0.5;
		const mat3 NOISE_MATRIX = mat3(
			vec3(13.323122, 23.5112, 21.71123),
			vec3(21.1212, 28.7312, 11.9312),
			vec3(21.8112, 14.7212, 61.3934)
		);
		// Scale coordinates based on layer depth
		float layer_scale = 1.0 + layer_index * 0.5 / (max(size, 0.01) * 2.0);
		vec2 scaled_coord = coord * layer_scale;
		
		// Apply movement (falling + wind)
		vec2 movement = vec2(
			scaled_coord.y * (spread * mod(layer_index * 7.238917, 1.0) - spread * 0.5) +
			(-wind_strength) * speed * time * 0.5,  // Reverse the wind direction by negating wind_strength
			-speed * time / (1.0 + layer_index * 0.5 * 0.03)
		);
		vec2 final_coord = scaled_coord + movement;
		
		// Generate noise pattern
		vec3 noise_input = vec3( floor(final_coord), 31.189 + layer_index);
		vec3 noise_val = floor(noise_input) * 0.00001 + fract(noise_input);
		vec3 random = fract((31415.9 + noise_val) / fract(NOISE_MATRIX * noise_val));
		
		// Calculate snowflake shape
		vec2 shape = abs(mod(final_coord, 1.0) - 0.5 + 0.9 * random.xy - 0.45);
		shape += P[1].x * abs(2.0 * fract(10.0 * final_coord.yx) - 1.0);
		// shape *= 0.6;
		
		// Calculate edge softness
		float depth_offset = 5.0 * sin(time * 0.1);
		float edge_softness = 0.005*dens + 0.05 * min(0.5 * abs(layer_index - 5.0 - depth_offset), 1.0);

		// Calculate final shape
		float shape_value = 0.6 * max(shape.x - shape.y, shape.x + shape.y) + max(shape.x, shape.y) - 0.01;

		return vec3(smoothstep(edge_softness, -edge_softness, shape_value) * (random.x / (1.0 + 0.02 * layer_index * 0.5)));
	}

	void main() {
		highp float t = P[0].x;
		const int num_of_layers = 10;
		vec4 snow_color = vec4( 1.0);
		float snow_transparency = 0.2;
		
		float dens = P[0].z;
		vec2 duv = P[3].xy;
		vec2 uv = (v_uv.xy - duv * 3.0) * dens;
		vec3 snow_accumulation = vec3(0.0);
		float wind = 0.1 * P[0].y;
		// Generate snow for each layer
		for (int i = 0; i < num_of_layers; i++) {
			snow_accumulation += generate_snowflake( uv, float(i), t, dens, wind);
		}
		// Calculate final color
		float snow_intensity = clamp( length(snow_accumulation), 0.0, 1.0);

		// Apply transparency effect to the snow color
		vec4 transparency_color = vec4( snow_color.rgb * (1.0 + snow_transparency), snow_intensity);
		fragcolor = transparency_color;
	}
}

technique snow
{
	apilevel = 30;

	pass {
		param = def;
		vs = def;
		fs = snow;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//
//	Sunshine
//	Low-cost morning rays and sparse animated glints.
//

fs sunshine
{
	float hash( highp vec2 p) {
		return fract( sin( dot( p, vec2( 41.0, 289.0))) * 45758.5453);
	}

	void main() {
		highp float t = P[0].x;
		highp float spd = P[0].y;
		highp float strength = P[0].z;
		highp vec2 cameraDrift = P[3].xy;
		highp float angle = P[0].w;
		highp float aspect = max( P[2].x, 0.1);
		highp vec2 dir = vec2( cos( angle), -sin( angle));
		highp vec2 side = vec2( -dir.y, dir.x);
		highp vec2 screenuv = vec2( v_uv.x * aspect, v_uv.y);
		const highp float baseAspect = 1.7777778;
		highp float lightx = clamp( P[2].y, -1.0, 1.0);
		highp float baseSourceX = (lightx * 0.5 + 0.5) * baseAspect;
		highp float sourceX = baseSourceX * aspect / baseAspect;
		highp vec2 lightSource = vec2( sourceX, 0.08);
		highp vec2 p = screenuv - lightSource;
		highp vec2 loopShift = vec2(
			sin( cameraDrift.x * 1.7 + cameraDrift.y * 0.8),
			sin( cameraDrift.y * 1.3 - cameraDrift.x * 0.6)
		) * 0.12;
		highp float along = dot( p, dir);
		highp float across = dot( p, side);
		highp float sunfade = smoothstep( 1.45, 0.0, length( p));
		highp float beamwidth = smoothstep( 0.85, 0.0, abs( across) / max( along, 0.1));
		highp float phase0 = sin( cameraDrift.x * 1.7 + cameraDrift.y * 1.4) * 2.4;
		highp float phase1 = sin( cameraDrift.y * 1.3 - cameraDrift.x * 0.9) * 3.1;
		highp float rays0 = 0.5 + 0.5 * sin( across * P[1].x * 13.0 + phase0 + t * spd * 0.16);
		highp float rays1 = 0.5 + 0.5 * sin( across * P[1].x * 29.0 + phase1 - t * spd * 0.09 + 1.7);
		highp float rays = (pow( rays0, 2.0) * 0.8 + pow( rays1, 6.0) * 0.4) * beamwidth * sunfade;
		highp float glow = pow( max( 0.0, 1.0 - length( p) * 1.7), 3.0) * 0.3;
		highp float sparkleAngle = angle + 0.62 + 0.18 * sin( cameraDrift.x * 1.1 - cameraDrift.y * 0.9);
		highp vec2 sparkleDir = vec2( cos( sparkleAngle), -sin( sparkleAngle));
		highp vec2 sparkleSide = vec2( -sparkleDir.y, sparkleDir.x);

		highp vec2 sparkleuv0 = v_uv;
		highp vec2 cell0 = floor( sparkleuv0 * P[1].x * 5.0);
		highp vec2 local0 = fract( sparkleuv0 * P[1].x * 5.0) - 0.5;
		highp vec2 point0 = vec2( hash( cell0 + 1.7), hash( cell0 + 8.3)) * 0.64 - 0.32;
		highp float active0 = smoothstep( 0.72, 0.9, hash( cell0 + 21.0));
		highp float pulse0 = smoothstep( 0.62, 0.98, 0.5 + 0.5 * sin( t * spd * 1.2 + phase0 * 0.8 + hash( cell0 + 3.0) * 6.28));
		highp vec2 delta0 = local0 - point0;
		highp float along0 = dot( delta0, sparkleDir);
		highp float across0 = dot( delta0, sparkleSide);
		highp float radius0 = 0.14 + hash( cell0 + 31.0) * 0.13;
		highp float core0 = smoothstep( radius0, 0.0, length( delta0));
		highp float arm0 = smoothstep( 0.022, 0.0, abs( across0)) * smoothstep( radius0 * 1.9, 0.0, abs( along0)) +
			smoothstep( 0.022, 0.0, abs( along0)) * smoothstep( radius0 * 1.9, 0.0, abs( across0));
		highp float star0 = arm0;
		highp float glint0 = (core0 + star0 * 0.55) * active0 * pulse0 * P[2].z;

		highp vec2 sparkleuv1 = v_uv;
		highp vec2 cell1 = floor( sparkleuv1 * P[1].x * 11.0 + 17.0);
		highp vec2 local1 = fract( sparkleuv1 * P[1].x * 11.0 + 17.0) - 0.5;
		highp vec2 point1 = vec2( hash( cell1 + 4.1), hash( cell1 + 11.6)) * 0.68 - 0.34;
		highp float active1 = smoothstep( 0.86, 0.97, hash( cell1 + 41.0));
		highp float pulse1 = smoothstep( 0.7, 0.99, 0.5 + 0.5 * sin( t * spd * 2.4 - phase1 * 0.65 + hash( cell1 + 9.0) * 6.28));
		highp vec2 delta1 = local1 - point1;
		highp float radius1 = 0.08 + hash( cell1 + 51.0) * 0.09;
		highp float along1 = dot( delta1, sparkleDir);
		highp float across1 = dot( delta1, sparkleSide);
		highp float core1 = smoothstep( radius1, 0.0, length( delta1));
		highp float arm1 = smoothstep( 0.018, 0.0, abs( across1)) * smoothstep( radius1 * 1.65, 0.0, abs( along1)) +
			smoothstep( 0.018, 0.0, abs( along1)) * smoothstep( radius1 * 1.65, 0.0, abs( across1));
		highp float glint1 = (core1 + arm1 * 0.45) * active1 * pulse1 * P[2].z;
		highp float glints = (glint0 + glint1 * 0.65) * sunfade;
		highp float light = clamp( (rays * 1.0 + glow + glints * 1.4) * strength, 0.0, 1.0);
		highp vec3 sunlight = P[1].yzw;
		fragcolor = vec4( sunlight * light, light);
	}
}

technique sunshine
{
	apilevel = 30;

	pass {
		param = def;
		vs = def;
		fs = sunshine;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//	
//	Distortion test

fs distortion
{
	void main() {
		highp float t = P[0].x;
		highp vec2 uv = vec2( v_uv.x, v_uv.y+sin( v_uv.x*10.0 + t)*0.05);
		mediump vec4 col = texture( coltex, uv);
		col *= vec4(0.5, 0.5, 1.0, 1.0);
		fragcolor = col;
	}
}

technique distortion
{
	apilevel = 30;

	pass {
		param = def;
		vs = def;
		fs = distortion;
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	
//	Heat haze
//	Depth-masked, multi-layer UV refraction for hot desert and lava surfaces.

fs heat_haze
{
	uint hash( uint x ) {
		x += ( x << 10u ); x ^= ( x >>  6u ); x += ( x <<  3u ); x ^= ( x >> 11u ); x += ( x << 15u );
		return x;
	}

	void main() {
		highp float t = P[0].x * P[0].y;
		highp float warp = P[0].z;
		highp float scale = max( P[0].w, 1.0);
		highp float aspect = max( P[1].x, 0.1);
		highp float gust = P[1].y;
		vec2 duv = P[3].xy;
		highp vec2 uv = v_uv;
		highp vec2 p = -duv + vec2( uv.x * aspect, uv.y) * scale;
		highp float depth = float( texture( uztex, uv).r) * P[2].z + P[2].w;	//	depth = meter
		depth = clamp( depth/30.0, 0.0, 1.0);	//	normalize depth to [0,1] based on 30 meters
		highp float mask = smoothstep( 0.0, 1.0, depth);	//	farther = more distortion, max at 30m
		highp vec2 wave0 = vec2(
			sin( p.y * 4.2 + t * 3.8) * 0.12 + sin( p.x * 1.8 - t * 2.6) * 0.06,
			cos( p.x * 2.4 + t * 3.2) + sin( p.y * 3.6 - t * 4.5)
		);
		highp vec2 wave1 = vec2(
			sin( p.y * 10.0 - t * 6.5 + p.x * 0.8) * 0.1,
			cos( p.x * 8.0 + t * 5.8 - p.y * 1.2) + sin( p.y * 9.0 - t * 7.0)
		);
		highp vec2 wave2 = vec2(
			sin( p.y * 22.0 + t * 11.0) * 0.06,
			cos( p.x * 17.0 - t * 9.0) + sin( p.y * 19.0 + t * 12.0)
		);
		highp float warpEff = warp * mask;
		highp vec2 baseOffset = (wave0 * 0.55 + wave1 * 0.3 + wave2 * 0.15) * warpEff;
		highp vec2 detailOffset = (wave1.yx * 0.6 + wave2 * 0.4) * warpEff;
		//	occasional ~300ms band of expansion sweeping bottom-to-top every 2.6s, independent of spd
		const highp float gustfreq = 1.3;
		const highp float gustdur = 0.4;
		highp uint gusti = uint( P[0].x / gustfreq) * 73856093u;
		gusti = hash( gusti);
		gust *= float( gusti & 1);
		highp float gustphase = mod( P[0].x, gustfreq);
		highp float gustprogress = clamp( gustphase / gustdur, 0.0, 1.0);
		highp float gustfront = mix( 1.1, -0.1, gustprogress);
		highp float gustband = exp( -pow( (uv.y - gustfront) / 0.15, 2.0));
		highp float gustwindow = smoothstep( 0.0, 0.04, gustphase) * (1.0 - smoothstep( gustdur-0.04, gustdur, gustphase));
		highp float gustmask = gustband * gustwindow * mask;
		highp vec2 gustOffset = vec2( sin( p.x * 3.0 + t * 8.0) * 0.4, 1.0) * gust * gustmask * 0.05;
		highp vec2 offset0 = baseOffset + gustOffset;
		highp vec2 offset1 = baseOffset * 0.58 + detailOffset * 0.12 + gustOffset * 0.7;
		highp vec2 offset2 = baseOffset * 0.32 - detailOffset * 0.08 + gustOffset * 0.45;
		mediump vec4 col0 = texture( coltex, clamp( uv + offset0, vec2( 0.001), vec2( 0.999)));
		mediump vec4 col1 = texture( coltex, clamp( uv + offset1, vec2( 0.001), vec2( 0.999)));
		mediump vec4 col2 = texture( coltex, clamp( uv + offset2, vec2( 0.001), vec2( 0.999)));
		fragcolor = col0 * 0.5 + col1 * 0.3 + col2 * 0.2;
	}
}

technique heat_haze
{
	apilevel = 30;

	pass {
		param = def;
		vs = def;
		fs = heat_haze;
	}
}







//////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////
//	
//	Loop Particle base technique
//	

param loopptc
{
	uniform lowp sampler2D coltex <id=COLORTEX1, MIN_FILTER=LINEAR, MAG_FILTER=LINEAR, WRAP_S=WRAP, WRAP_T=WRAP>;
	uniform highp usampler2D uztex <id=DEPTHTEX, WRAP_S=CLAMP, WRAP_T=CLAMP, MIN_FILTER=NEAREST, MAG_FILTER=NEAREST>;
	
	uniform highp mat4 invpmat <id=ENV2MAT>;
	uniform highp mat4 invvmat <id=ENV3MAT>;
	uniform highp mat4 vmat <id=VMAT>;
	uniform highp mat4 pmat <id=PMAT>;
	uniform highp mat4 P <id=MISC1MAT>;
	uniform highp mat4 R <id=MISC2MAT>;
	
	varying mediump vec3 v_wvp;
	varying mediump vec2 v_uv;
	varying mediump vec4 v_col;
	
	fragout mediump vec4 fragcolor;

	struct Element {
		highp vec3 wp;			//	world pos
		mediump vec2 size;
		mediump float rot;
		mediump vec4 col;
	};
}

vs loopptcutil
{
	uint hash( uint x ) {
		x += ( x << 10u ); x ^= ( x >>  6u ); x += ( x <<  3u ); x ^= ( x >> 11u ); x += ( x << 15u );
		return x;
	}

	highp vec3 loop( highp vec3 v, highp vec3 mi, highp vec3 size){
		return mod( v - mi, size) + mi;
	}

	highp vec3 makepos( highp uint seed, highp vec3 mi, highp vec3 size){
		highp float x = float( hash(seed) & 0xFFFFu) / 65535.0;
		highp float y = float( hash(seed+12311u) & 0xFFFFu) / 65535.0;
		highp float z = float( hash(seed+141231u) & 0xFFFFu) / 65535.0;
		return loop( vec3( x, y, z) * size, mi, size);
	}

	vec2 rotate( vec2 p, float rot){
		float c = cos( rot);
		float s = sin( rot);
		mat2 m = mat2(c, -s, s, c);
		return m * p;
	}

	highp float rndf( uint seed, highp float range){
		return float( seed & 0xFFFFFFu) / 16777215.0 * range;
	}
}


vs loopptc
{
	void main(){
		const vec2 quads[4] = vec2[4](
			vec2(-0.5, -0.5),
			vec2( 0.5, -0.5),
			vec2(-0.5,  0.5),
			vec2( 0.5,  0.5)
		);
		const vec2 uvs[4] = vec2[4](
			vec2(0.0, 0.0),
			vec2(1.0, 0.0),
			vec2(0.0, 1.0),
			vec2(1.0, 1.0)
		);
		//	Extract time, minimum position, and size from the uniform matrix R.
		highp float time = P[0].x * P[0].y;
		highp vec3 mi = R[0].xyz;
		highp vec3 size = R[1].xyz;
		uint id = uint( gl_InstanceID), vid = uint( gl_VertexID) & 3u;
		uint seed = hash( id*12345u + 123151u);
		highp vec3 pos = makepos( seed, mi, size);
		//	Generate the element for this instance using the calculated position and time.
		Element e = makeelem( id, pos, seed, time);
		vec3 qoffs = vec3( rotate( quads[vid], e.rot) * e.size, 0.0);
		highp vec4 wvp = vmat * vec4(e.wp, 1.0), wvpp = pmat * wvp;
		highp uint texz = texture( uztex, wvpp.xy/wvpp.w * 0.5 + 0.5).x;
		highp uint uz = uint( (-wvp.z - R[3].w) / R[3].z);	//	0~65535
		if( texz < uz) qoffs = vec3(0.0);	//	ztest
		//
		wvp = wvp + vec4( qoffs, 0.0);
		gl_Position = pmat * wvp;
		v_wvp = wvp.xyz;
		v_col = e.col;
		v_uv = uvs[vid];
	}
}

fs loopptc
{
	void main(){
		fragcolor = texture2D( coltex, v_uv) * v_col;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//	
//	Particle weather
//	

vs particle
{
	Element makeelem( highp uint id, highp vec3 wp0, uint seed, highp float time){
		Element e;
		highp float dens = P[0].z;
		highp float t0 = rndf( seed, 1000.0), freq = 20.0 * (1.0+rndf( seed*12345u, 1.0)), tr = 0.1 * (1.0+rndf( seed*54321u, 1.0));
		highp float t1 = (time + t0) / freq;
		highp float t = fract( t1) / tr;
		highp uint tseed = hash( seed*31u + uint( t1)*113);	//	
		e.wp = wp0;
		e.size = vec2( P[0].w * (0.95 + 0.1 * rndf( tseed, 1.0)));
		e.rot = 0.0;
		e.col = P[1u+(tseed&1u)];
		if( t < 1.0){
			//	movement
			vec3 dp0 = vec3( rndf( tseed, 1.0), rndf( tseed*12345u, 1.0), rndf( tseed*54321u, 1.0));
			vec3 dp1 = vec3( rndf( tseed*31u, 1.0), rndf( tseed*67u, 1.0), rndf( tseed*72145u, 1.0));
			vec3 dp = mix( dp0, dp1, t);
			//	falloff
			e.wp += dp;
			vec4 wvp = vmat * vec4(e.wp, 1.0);
			float foff = clamp( min( -wvp.z*0.12, 1.4 - (-wvp.z/30.0)*1.4), 0.0, 1.0);
			//
			e.col.w = clamp( min( t*5.0, 2.0-t*2.0) * foff, 0.0, 1.0);
			e.size *= vec2( sin( t * 3.14159265 * 6.0) * 0.1 + 1.0);
		}else{
			e.size = vec2( 0.0);
		}
		return e;
	}
}

technique particle
{
	apilevel = 30;
	
	pass {
		using loopptcutil, particle;
		param = loopptc;
		vs = loopptc;
		fs = loopptc;
	}
}
