		]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_runtime_reload_tool

mcptools .. {
	name = "rpgcobo_runtime_reload_tool",
	desc = "Reloads the RPG-Cobo tool. All of the data, resources, and programs will be reloaded.",
	argdef = {
	},
	func = @( args){
		::skstudio.saveAllFiles();
		newthread().start( @(){
			sleep( 100);
			::skstudio.menuRelaunch( {force=1});
		}, this);
		return { content=[
			{ type="text", text="RPG-Cobo tool will be reloaded soon(in a second)." }
		]};
	},
}

