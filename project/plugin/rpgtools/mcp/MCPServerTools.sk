////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_editor_open_data

mcptools .. {
	name = "rpgcobo_editor_open_data",
	desc = "Opens a database item in the editor.",
	argdef = {
		id = { type="string", desc="Database item ID (can be retrieved from rpgcobo_project_list_database)", required=true },
	},
	func = @( args){
		local dataid = args["id"];
		local dbtype = RPGData.getDataType( dataid);
		local path = ".x/%S/%S" % (dbtype, dataid);
		::skstudio.openEditor( path);
		local ed = ::skstudio.editor;
		if( ed["name"] == "editor_empty"){
			return {
				content=[{ type="text", text="Editor open error. path=%S" % path }, ],
				isError = true,
			};
		}
		return { content=[
			{ type="text", text="Editor opened. path=%S" % path },
		]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_editor_open_editor

mcptools .. {
	name = "rpgcobo_editor_open_editor",
	desc = "Opens a project item in its native editor. Tool paths use /project as the root.",
	argdef = {
		path = { type="string", desc="Project-root path such as /resource/efx/example.ptd or /system/asset/def.ptd", required=true },
	},
	func = @( args){
		local path = args["path"];
		if( !path.startsWith( "/") || path.startsWith( "/project/") || path.contains( "..")){
			throw Exception( "Invalid project-root path: %S" % path, -32602);
		}
		::skstudio.openEditor( path);
		local ed = ::skstudio.editor;
		if( ed["name"] == "editor_empty"){
			return {
				content=[{ type="text", text="Editor open error. path=%S" % path }, ],
				isError = true,
			};
		}
		return { content=[
			{ type="text", text="Editor opened. path=%S" % path },
		]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_log_tail

mcptools .. {
	name = "rpgcobo_log_tail",
	desc = "Returns the last N lines of the rpgcobo log file.",
	argdef = {
		lines = { type="number", desc="Number of lines to return", "default"=100 },
	},
	func = @( args){
		local lines = int( args["lines"]) || 100;
		flushStdOut();
		local f = FileRef( ::logpath);
		if( !f.exists()){
			return {
				content=[{ type="text", text="Log file does not exist." }, ],
				isError = true,
			};
		}
		local logtext = f.load().asText();
		local loglines = logtext.split( "\n");
		local startline = Math.max( 0, length( loglines) - lines);
		return { content=[
			{ type="text", text=loglines.slice( startline).join( "\n") }
		]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_runtime_execute

mcptools .. {
	name = "rpgcobo_runtime_execute",
	desc = "Executes any sk script.",
	argdef = {
		script = { type="string", desc="SK script to execute", required=true },
	},
	func = @( args){
