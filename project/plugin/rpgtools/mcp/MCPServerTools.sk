////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_runtime_screenshot

mcptools .. {
	name = "rpgcobo_runtime_screenshot",
	desc = "Takes a screenshot of the RPG-Cobo tool in debug session.",
	argdef = {
	},
	func = @( args){
		//	Capture rootview
		local sp = ::rootview.capture(), tex = sp.tex0;
		local img = RGBAImage( tex.width, tex.height);
		local old = skGetRenderTarget();
		skSetRenderTarget( tex);
		skReadPixels( 0, 0, img.width, img.height, img);
		skSetRenderTarget( old);
		//	Encode and save png
		local bb = img.encodePNG(); bb.pos = 0;
		//	ok
		return { content=[{
			type = "image",
			mimeType = "image/png",
			data = encodeBASE64( bb),
		}]};
	},
}

local debugnotrunning = {
	content=[ { type="text", text="RPG-Cobo debug session is not running." } ],
	isError = true,
};

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_debug_start

mcptools .. {
	name = "rpgcobo_debug_start",
	desc = "Starts the RPG-Cobo debug session (Test Play).",
	argdef = {
		"saveslot": { type="number", desc="Save slot to use (-2: title, -1: new game, 0-99: existing save slots)", "default"=-1 },
		"debugitems": { type="boolean", desc="Player has all items", "default"=false },
		"debugskills": { type="boolean", desc="Player has all skills", "default"=false },
		"debuglv": { type="number", desc="Specify level of all player characters", "default"=0 },
	},
	func = @( args){
		//	別スレッドでデバッグ開始。プロセスが終了したらdebugpidをクリアする。
		local debugargs = {
			uid="menu_debug_start",
			slot=args["saveslot"]??-1,
			debugitems=args["debugitems"]??false,
			debugskills=args["debugskills"]??false,
			debuglv=args["debuglv"]??0,
		};
		startDebugMenu( debugargs);
		//
		if( ::debugsession){
			return { content=[ { type="text", text="RPG-Cobo debug session started." } ]};
		}else{
			return { content=[ { type="text", text="Failed to start RPG-Cobo debug session." } ], isError = true, };
		}
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_debug_get_status

mcptools .. {
	name = "rpgcobo_debug_get_status",
	desc = "Gets the status of the RPG-Cobo debug session.",
	argdef = {
	},
	func = @( args){
		if( !::debugsession) return debugnotrunning;
		local stats = ::debugsession.ipc.invokeIPCScript( "return getDebugStatus();" );
		local a = { content=[
			{ type="text", text="Running: true" },
			...stats.map( @( v)+{ type="text", text=v }),
		]};
		return a;
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_debug_pause

mcptools .. {
	name = "rpgcobo_debug_pause",
	desc = "Pauses/Resumes the RPG-Cobo debug session.",
	argdef = {
		pause = { type="boolean", desc="Whether to pause (true) or resume (false) the RPG-Cobo debug session", required=true, "default"=true },
	},
	func = @( args){
		if( !::debugsession) return debugnotrunning;
		::debugsession.setPaused( !!args.pause);
		return { content=[ { type="text", text="RPG-Cobo debug session has " + (args.pause? "paused." : "resumed.") } ]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_debug_screenshot

mcptools .. {
	name = "rpgcobo_debug_screenshot",
	desc = "Takes a screenshot of the RPG-Cobo debug session.",
	argdef = {},
	func = @( args){
		if( !::debugsession) return debugnotrunning;
		local bb = ::debugsession.ipc.invokeIPCScript( "return getDebugScreenShot();" );
		return { content=[{
			type = "image",
			mimeType = "image/png",
			data = encodeBASE64( bb),
		}]};
	},
}

////////////////////////////////////////////////////////////////////////////////////////
//	rpgcobo_debug_stop

mcptools .. {
	name = "rpgcobo_debug_stop",
	desc = "Stops the RPG-Cobo debug session.",
	argdef = {},
	func = @( args){
		if( !::debugsession) return debugnotrunning;
		::debugsession.finish();
		return { content=[ { type="text", text="RPG-Cobo debug session stopped." } ]};
	},
}

