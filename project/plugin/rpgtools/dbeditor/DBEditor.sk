//	パスからDBのタイプを取得。無いならnull
function getdbtype( path){
	local r = getResource( path);
	if( r instanceof ::GameConfigResource) return r.name;
	if( r instanceof ::ConfigItemResource) return r.pres.name;
	return null;
}

class DBEditor extends EditorViewBase
{
	static typereg = {};		//	DBタイプごとのエディタ等登録

	res = null;				//	Resource : 
	data = null;			//	P000等のデータのコピー。

	static function registerDBType( dbtype, cls){
		typereg[dbtype] <- cls;
	}

	//	作業中のデータでデバッグするための情報取得
	function getWorkingData(){
		local t = { conf={}};
		t.conf[res.pres.name] <- { [res.name] = data };
		return t;
	}
}

/////////////////////////////////////////////////////////////////////////////
//	register SKStudio

FileIcons["db"] <- ("\ue80b",0x77ddddff)

with( skstudio){
	registerEditor( {
		uid = "editor_db",
		matches = @( path){
			local cls = ::DBEditor.typereg[getdbtype( path)];
			return cls;
		}
		createEditor = @( path){
			local cls = ::DBEditor.typereg[getdbtype( path)];
			if( cls){
				local ed = ::loadSKView( cls.UIPATH, cls);
				ed?.init( path);
				return ed;
			}
			return null;
		},
		createPreview = @( path){
			local cls = ::DBEditor.typereg[getdbtype( path)];
			if( cls["createPreview"]) return cls.createPreview( path);
			return null;
		}
		sideview = "side_dbview"
	});
}
