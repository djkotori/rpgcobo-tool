///////////////////////////////////////////////////////////////////////////////////////
//	MapGeneratorのパラメータ。全て RANGE タイプ。
//

//	シードもプロパティ化。
local seedprop = {
	pid="seed", lbl="$T.lbl_rndseed", type=SCALAR, notarg=1,
	range=(0,10000000), defval=12345
};

//	サイズもプロパティ化。ワールドマップとダンジョンでは大きさが違うので、パラメータ化しておく。
local sizeprop = {
	pid="size", lbl="$T.lbl_size", type=VEC2, notarg=1,
	range=(64,1024), q=1, ui="x", defval=[128,128]
};

//	共通ブロック生成パラメータ
//
local baseyprop = {
	pid="basey", lbl="$T.lbl_basey", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(1.0,16.0), q=10, defval=[1.2,1.8]
};

local heightscaleprop = {
	pid="heightscale", lbl="$T.lbl_heightscale", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(0.1,3.0), q=10, defval=[1.0,1.4]
};

local heightnoiseprop = {
	pid="heightnoise", lbl="$T.lbl_heightnoise", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(0.0,2.0), q=10, defval=[0.8,1.2]
};

//	共通オブジェクト生成パラメータ
//	
local treedensprop = {
	pid="treedens", lbl="Tree Density", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(0.0,1.0), q=100, defval=[0.5,0.8]
};

local rockdensprop = {
	pid="rockdens", lbl="Rock Density", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(0.0,1.0), q=100, defval=[0.2,0.3]
};

local flowerdensprop = {
	pid="flowerdens", lbl="Flower Density", type=RANGE, cnt="cnt6.ui", notarg=1,
	range=(0.0,1.0), q=100, defval=[0.2,0.3]
};


local _c( r, g, b){ return r | (g<<8) | (b<<16); }
local _macrowgt( arch, cont, basin){ return { macroArchipelagoWeight=arch, macroContinentWeight=cont, macroBasinWeight=basin}; }
local _layoutwgt( bub, ring, branch){ return { layoutHubWeight=bub, layoutRingWeight=ring, layoutBranchWeight=branch}; }	

//	マップ生成定義リスト。
//	mapimggen.exe に渡すパラメータや、mapimggen.exeの出力pngからBlockWorldを作るためのパラメータを定義する。
//	
::MapGenerators <- [
	////////////////////////////////////////////////////////////////////////////////////////////////////////
	//	world タイプ。平面なフィールドマップを生成する。画像は1/2サイズで生成される。
	//	スケールはリアル縮尺からは小さめ。一つの大きな世界を一つのマップに収めるような生成。
	{
		lbl="WorldMap", val="world", 
		halfimg = true,
		//
		props=[
			{ ...sizeprop, defval=[256,256] },
			seedprop,
			//	画像生成パラメータ
			{ pid="mode", lbl="$T.lbl_mode", type=LIST, list=[
				{ lbl="$T.lbl_random", val=_macrowgt( 0.33, 0.34, 0.33) },
				{ lbl="大陸", val=_macrowgt( 1.0, 0.0, 0.0) },
				{ lbl="島々", val=_macrowgt( 0.0, 1.0, 0.0) },
				{ lbl="盆地", val=_macrowgt( 0.0, 0.0, 1.0) },
			], defval=_macrowgt(0.33, 0.34, 0.33) },
			{ pid="seaLevel", lbl="Sea Rate", type=RANGE, cnt="cnt6.ui", range=(0.1,0.99), q=100, defval=[0.3,0.65] },
			{ pid="scale", lbl="Land Scale", type=RANGE, cnt="cnt6.ui", range=(0.2,4.0), q=100, defval=[0.9,3.0] },
			{ pid="ridgeStrength", lbl="Ridge Strength", type=RANGE, cnt="cnt6.ui", range=(0.1,1.2), q=100, defval=[0.4,0.55] },
			{ pid="riverDensity", lbl="River Dens", type=RANGE, cnt="cnt6.ui", range=(0.1,3.0), q=100, defval=[0.8,1.2] },
			{ pid="roadDensity", lbl="Road Density", type=RANGE, cnt="cnt6.ui", range=(0.1,3.0), q=100, defval=[0.8,1.2] },
			{ pid="basinCornerRound", lbl="Basin CornerRound", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.25,0.5] },
			{ pid="basinEdgeInner", lbl="Basin EdgeInner", type=RANGE, cnt="cnt6.ui", range=(0.55,0.90), q=100, defval=[0.6,0.8] },
			{ pid="basinWallInner", lbl="Basin WallInner", type=RANGE, cnt="cnt6.ui", range=(0.70,0.95), q=100, defval=[0.9,0.92] },
			{ pid="riverMinBase", lbl="River MinBase", type=RANGE, cnt="cnt6.ui", range=(1.0,8.0), q=10, defval=[1.5,2.5] },
			{ pid="riverMaxBase", lbl="River MaxBase", type=RANGE, cnt="cnt6.ui", range=(1.0,12.0), q=10, defval=[4.5,5.5] },
			{ pid="roadExtraEdgeRate", lbl="Road ExtraEdgeRate", type=RANGE, cnt="cnt6.ui", range=(0.0,1.2), q=100, defval=[0.45,0.55] },
			{ pid="bridgeMinInterval", lbl="Bridge MinInterval", type=RANGE, cnt="cnt6.ui", range=(0.0,1.2), q=100, defval=[0.45,0.55] },
			//	iran? coastHeightFilterPasses, coastHeightFilterBand, basinLandRimThreshold
			//	ブロック生成パラメータ
			baseyprop,
			heightscaleprop, 
			heightnoiseprop,
			//	オブジェクト配置パラメータ
			rockdensprop,
			treedensprop,
			flowerdensprop
		],
		blkmaplist = [
			{ id=PLAIN, lbl="PLAIN", type="blk", blkpages=[2,3] },
			{ id=DESERT, lbl="DESERT", type="blk", blkpages=[2,3] },
			{ id=FOREST, lbl="FOREST", type="blk", blkpages=[2,3] },
			{ id=MOUNTAIN, lbl="MOUNTAIN1", type="blk", blkpages=[2,3] },
			{ id=MOUNTAIN_VAR, lbl="MOUNTAIN2", type="blk", blkpages=[2,3] },
			{ id=EXMOUNTAIN, lbl="EXMOUNTAIN", type="blk", blkpages=[2,3] },
			{ id=ROAD, lbl="ROAD", type="blk", blkpages=[2,3] },
			{ id=BRIDGE, lbl="BRIDGE", type="blk", blkpages=[2,3] },
			null,
			{ id=RIVER, lbl="RIVER", type="blk", blkpages=[8] },
			{ id=LAKE, lbl="LAKE", type="blk", blkpages=[8] },
			{ id=SEA, lbl="SEA", type="blk", blkpages=[8] },
			{ id=ROCK_S, lbl="ROCK_S", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=ROCK_M, lbl="ROCK_M", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=ROCK_L, lbl="ROCK_L", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=TREE_S, lbl="TREE_S", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=TREES_S, lbl="TREES_S", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=TREES_M, lbl="TREES_M", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=TREES_L, lbl="TREES_L", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=FLOWERS_A, lbl="FLOWERS_A", type="blk", blkpages=[11] },
			{ id=FLOWERS_B, lbl="FLOWERS_B", type="blk", blkpages=[11] },
			{ id=FLOWERS_C, lbl="FLOWERS_C", type="blk", blkpages=[11] },
		],
		biocolor=[
			_c( 114, 187, 78),		//	PLAIN
			_c( 231, 209, 136),		//	DESERT
			_c( 47, 129, 53),		//	FOREST
			_c( 146, 146, 146),		//	MOUNTAIN
			_c( 105, 105, 105),		//	EXMOUNTAIN
			_c( 216, 189, 116),		//	ROAD
			_c( 154, 108, 62),		//	BRIDGE
			_c( 47, 124, 234),		//	RIVER
			_c( 70, 145, 240),		//	LAKE
			_c( 28, 90, 202),		//	SEA
		],
		biohmap = [
			1.0,	//	PLAIN
			1.0,	//	DESERT
			1.0,	//	FOREST
			1.8,	//	MOUNTAIN
			2.4,	//	EXMOUNTAIN
			1.0,	//	ROAD
			1.0,	//	BRIDGE
			0.0,	//	RIVER
			0.0,	//	LAKE
			0.0,	//	SEA
		],
		bioobjdensmap = {
			[PLAIN]:     { [ROCK_S]: 0.2, [ROCK_M]: 0.1, [ROCK_L]: 0.1, [TREES_S]: 0.2, [TREES_M]: 0.04, [TREES_L]: 0.0, [TREE_S]: 0.1,[FLOWERS_A]: 0.4, [FLOWERS_B]: 0.3, [FLOWERS_C]: 0.3},
			[DESERT]:    { [ROCK_S]: 0.3, [ROCK_M]: 0.4, [ROCK_L]: 0.3, [TREES_S]: 0.04,[TREES_M]: 0.0,  [TREES_L]: 0.0, [TREE_S]: 0.0, [FLOWERS_A]: 0.0, [FLOWERS_B]: 0.0, [FLOWERS_C]: 0.0},
			[FOREST]:    { [ROCK_S]: 0.1, [ROCK_M]: 0.2, [ROCK_L]: 0.05,[TREES_S]: 0.34,[TREES_M]: 1.5,  [TREES_L]: 0.4, [TREE_S]: 0.65, [FLOWERS_A]: 0.05,[FLOWERS_B]: 0.1, [FLOWERS_C]: 0.0},
			[MOUNTAIN]:  { [ROCK_S]: 0.2, [ROCK_M]: 0.4, [ROCK_L]: 0.6, [TREES_S]: 0.04,[TREES_M]: 0.02, [TREES_L]: 0.0, [TREE_S]: 0.0, [FLOWERS_A]: 0.0, [FLOWERS_B]: 0.0, [FLOWERS_C]: 0.0},
		},
		objsizemap = {
			[ROCK_S]: 2, [ROCK_M]: 3, [ROCK_L]: 4, [TREES_S]: 2, [TREES_M]: 3, [TREES_L]: 4, [TREE_S]: 3, [FLOWERS_A]: 1, [FLOWERS_B]: 2, [FLOWERS_C]: 3,
		},
		//	ツールから置き換え可能。MapGenerator定義ごとにある
		blkmap = {
			[PLAIN]=2|(1<<5), [DESERT]=2|(7<<5), [FOREST]=2|(27<<5), 
			[MOUNTAIN]=2|(24<<5), [EXMOUNTAIN]=2|(57<<5), [ROAD]=2|(6<<5), [BRIDGE]=3|(22<<5), 
			[RIVER]=8|(0<<5), [LAKE]=8|(0<<5), [SEA]=8|(0<<5), 
			[MOUNTAIN_VAR]=2|(0<<5),
			//
			[ROCK_S]=20|(17<<12), [ROCK_M]=20|(18<<12), [ROCK_L]=20|(19<<12), 
			[TREES_S]=20|(74<<12), [TREES_M]=20|(75<<12), [TREES_L]=20|(76<<12), [TREE_S]=20|(67<<12),
			[FLOWERS_A]=11|(0<<5), [FLOWERS_B]=11|(1<<5), [FLOWERS_C]=11|(2<<5),
		},
		//	zoom時の境界処理。川や道路の境界を滑らかにする。川はボールド処理を施す。
		zoomfunc = @(){
			local rnd = rnd;
			local wbits = (1<<SEA)|(1<<LAKE)|(1<<RIVER);
			return @( win, b4){
				local c = win[4];
				b4.fill( c);
				switch( c){
				case RIVER: case ROAD: case BRIDGE:
					break;
				case SEA: case LAKE:
					if( win.countUsed( c) < 9 && win.countUsed( RIVER) == 0){
						local x = rnd( 0, 0xffff);
						local f = win[1], l = win[3], b = win[7], r = win[5];
						if( !((1<<f) & wbits) && (x&2)) b4[0] = b4[3] = f;
						if( !((1<<l) & wbits) && (x&8)) b4[0] = b4[1] = l;
						if( !((1<<b) & wbits) && (x&32)) b4[1] = b4[2] = b;
						if( !((1<<r) & wbits) && (x&256)) b4[2] = b4[3] = r;
					}
					break;
				case MOUNTAIN:
					local f = win[1], l = win[3], b = win[7], r = win[5];
					local x = rnd( 0, 0xffff);
					if( f != MOUNTAIN && !(x&0x2)) b4[0] = b4[3] = f;
					if( l != MOUNTAIN && !(x&0x4)) b4[0] = b4[1] = l;
					if( b != MOUNTAIN && !(x&0x8)) b4[1] = b4[2] = b;
					if( r != MOUNTAIN && !(x&0x10)) b4[2] = b4[3] = r;
					break;
				default:
					local f = win[1], l = win[3], b = win[7], r = win[5];
					//	RIVER
					if( win.countUsed( RIVER)){
						local x = rnd( 0, 0xffff);
						if( f==RIVER && (x&0x7)) b4[0] = b4[3] = RIVER;
						if( l==RIVER && (x&0x70)) b4[0] = b4[1] = RIVER;
						if( b==RIVER && (x&0x700)) b4[1] = b4[2] = RIVER;
						if( r==RIVER && (x&0x7000)) b4[2] = b4[3] = RIVER;
					}
					//	ROAD
					if( win.countUsed( ROAD) >= 2){
						local x = rnd( 0, 0xffff);
						if( f==ROAD && l==ROAD && win[0]!=ROAD){
							b4[0] = ROAD; if( x&0x1) b4[1] = ROAD;
						}
						if( l==ROAD && b==ROAD && win[6]!=ROAD){
							b4[1] = ROAD; if( x&0x2) b4[2] = ROAD;
						}
						if( b==ROAD && r==ROAD && win[8]!=ROAD){
							b4[2] = ROAD; if( x&0x4) b4[3] = ROAD;
						}
						if( f==ROAD && r==ROAD && win[2]!=ROAD){
							b4[3] = ROAD; if( x&0x8) b4[0] = ROAD;
						}
					}
				}
			}
		},
		//	バイオーム画像からブロック、高さ画像を生成する。dst[i] = blk | (y<<16) の形式で返す。
		blkheightfunc = @( bio, dst){
			local w = bio.width, h = bio.height;
			local basey = getrange( gendata["basey"], 2.5), hscale = getrange( gendata["heightscale"], 1.0), hnoise = getrange( gendata["heightnoise"], 1.0);
			local biohmap = gendef.biohmap, blkmap = blkmap, rnd = rnd;
			local wbits = (1<<SEA)|(1<<LAKE)|(1<<RIVER);
			return @( x, z, i){
				local b = bio[i];
				local blk = blkmap[b], bh = biohmap[b];
				local y = basey * hscale * bh;	//	ブロックのyはバイオームごとに基本固定の値になる。ノイズでの上下みたいなのは無し。
				if( !((1<<b) & wbits)){	//	周囲に水系が多い場合は水系に置き換える。
					local sc = bio.countUsed( SEA, x-1, z-1, 3, 3), lc = bio.countUsed( LAKE, x-1, z-1, 3, 3), rc = bio.countUsed( RIVER, x-1, z-1, 3, 3);
					if( sc + lc + rc > 5){
						b = (sc > lc && sc > rc) ? SEA : (lc > rc) ? LAKE : RIVER;
						blk = blkmap[b]; bh = biohmap[b];
						y = basey * hscale * bh;
					}
				}
				switch( b){
				case MOUNTAIN:
					local nm = Math.pow( (bio.countUsed( MOUNTAIN, x-2, z-2, 5, 5) + bio.countUsed( EXMOUNTAIN, x-2, z-2, 5, 5)) / 25.0, 1.4);
					local nz = ::NoiseGen.value( x*0.15, z*0.15, 13245, 3, 2.0, 0.5);
					y += (nz * 6.2 * nm ) * hnoise;
					local w = ::NoiseGen.worley( x*0.14, z*0.14, 512412); w*=w;
					if( w >= 0.1){ y -= 1; }
					if( nz >= 0.5){ blk = blkmap[MOUNTAIN_VAR]; }
					break;
				case EXMOUNTAIN:
					local nm = Math.pow( (bio.countUsed( EXMOUNTAIN, x-2, z-2, 5, 5)) / 25.0, 1.4);
					local nz = ::NoiseGen.value( x*0.15, z*0.15, 13245, 2, 2.0, 1.5);// x*0.15, z*0.15, 13245, 3, 2.0, 0.5);
					y += (nz * (3.5 + 5.2*nm)) * hnoise;
					local w = ::NoiseGen.worley( x*0.14, z*0.14, 512412); w*=w;
					if( w >= 0.1) y -= 1.5;
					if( nz <= 0.2){ blk = blkmap[MOUNTAIN]; }
					else if( nz <= 0.4){ blk = blkmap[MOUNTAIN_VAR]; }
					break;
				}
				y = Math.iround( y);
				return blk | (y<<16);
			}
		}
	},
	////////////////////////////////////////////////////////////////////////////////////////////////////////
	//	cave タイプ。自然の洞窟
	{	
		lbl="Cave", val="cave", 
		halfimg = false,
		//
		props=[
			{ ...sizeprop, defval=[160,160] },
			seedprop,
			//	画像生成パラメータ
			{ pid="largeCellSize", lbl="L-Cell size", type=RANGE, cnt="cnt6.ui", range=(10.0,50.0), q=1, defval=[22.0,38.0] },
			{ pid="mediumCellSize", lbl="M-Cell size", type=RANGE, cnt="cnt6.ui", range=(5.0,30.0), q=1, defval=[9.0,19.0] },
			{ pid="largeWeight", lbl="Large weight", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.35,0.6] },
			{ pid="mediumWeight", lbl="Medium weight", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.15,0.35] },
			{ pid="noiseWeight", lbl="Noise weight", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.2,0.4] },
			{ pid="noiseScale", lbl="Noise scale", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.01,0.04] },
			{ pid="wallThreshold", lbl="Wall threshold", type=RANGE, cnt="cnt6.ui", range=(0.3,0.90), q=100, defval=[0.5,0.62] },
			{ pid="floorLv2CellSize", lbl="LV2-Cell size", type=RANGE, cnt="cnt6.ui", range=(5.0,50.0), q=1, defval=[9.0,16.0] },
			{ pid="floorLv2TopRatio", lbl="Floor LV2 Top ratio", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.34,0.5] },
			{ pid="floorLv2Variation", lbl="Floor LV2 Variation", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.18,0.36] },
			{ pid="floorLv2CliffFrequency", lbl="Floor LV2 Cliff Frequency", type=RANGE, cnt="cnt6.ui", range=(0.0,0.2), q=100, defval=[0.11,0.14] },
			{ pid="floorLv2CliffStrength", lbl="Floor LV2 Cliff Strength", type=RANGE, cnt="cnt6.ui", range=(0.0,8.0), q=10, defval=[3.0,6.0] },
			// { pid="floorLv2GenerationRetries", lbl="Floor LV2 Generation Retries", type=RANGE, cnt="cnt6.ui", range=(0.0,20.0), q=1, defval=[40,50] },
			{ pid="lakeChance", lbl="Lake Chance", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.2,0.5] },
			{ pid="lakeMaxCount", lbl="Lake Count", type=RANGE, cnt="cnt6.ui", range=(0.0,10.0), q=10, defval=[2.8,6.5] },
			{ pid="lakeMaxWidth", lbl="Lake Max Width", type=RANGE, cnt="cnt6.ui", range=(10.0,40.0), q=1, defval=[16,24] },
			{ pid="lakeMaxDepth", lbl="Lake Max Depth", type=RANGE, cnt="cnt6.ui", range=(4.0,40.0), q=1, defval=[8,14] },
			//	iran? noiseOctaves borderThickness
			//	ブロック生成パラメータ
			baseyprop,
			heightscaleprop, 
			heightnoiseprop,
			//	オブジェクト配置パラメータ
			rockdensprop,
		],
		blkmaplist = [
			{ id=FLOOR1, lbl="FLOOR_LV1", type="blk", blkpages=[2,3] },
			{ id=FLOOR2, lbl="FLOOR_LV2", type="blk", blkpages=[2,3] },
			{ id=WALL, lbl="WALL", type="blk", blkpages=[2,3] },
			{ id=INNERWALL, lbl="INNER WALL", type="blk", blkpages=[2,3] },
			{ id=LAKE1, lbl="LAKE", type="blk", blkpages=[8] },
			null,
			{ id=ROCK_S, lbl="ROCK_S", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=ROCK_M, lbl="ROCK_M", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
			{ id=ROCK_L, lbl="ROCK_L", type="fblk", fbpages=[FB_TREE,FB_ROCK] },
		],
		biocolor=[
			_c( 74, 125, 74),		//	FLOOR_LV1
			_c( 111, 162, 111),		//	FLOOR_LV2
			_c( 255, 255, 255),		//	NOT USED
			_c( 96, 82, 68),		//	WALL
			_c( 8, 10, 14),			//	INNERWALL
			_c( 255, 255, 255),		//	NOT USED
			_c( 182, 122, 77),		//	LADDER
			_c( 38, 184, 224),		//	RIVER
			_c( 34, 66, 168),		//	LAKE
		],
		bioobjdensmap = {
			[PLAIN]:     { [ROCK_S]: 0.4, [ROCK_M]: 0.3, [ROCK_L]: 0.2, },
			[DESERT]:    { [ROCK_S]: 0.3, [ROCK_M]: 0.2, [ROCK_L]: 0.1, },
		},
		objsizemap = {
			[ROCK_S]: 2, [ROCK_M]: 3, [ROCK_L]: 4, [TREE_S]: 3, [TREE_M]: 3, [TREE_L]: 5, [FLOWERS_A]: 1, [FLOWERS_B]: 2, [FLOWERS_C]: 3,
		},
		//	ツールから置き換え可能。MapGenerator定義ごとにある
		blkmap = {
			[FLOOR1]=2|(24<<5), [FLOOR2]=2|(0<<5), 
			[WALL]=2|(60<<5), [INNERWALL]=3|(35<<5), 
			[LAKE1]=8|(0<<5), 
			//
			[ROCK_S]=20|(17<<12), [ROCK_M]=20|(18<<12),// [ROCK_L]=20|(19<<12), 
		},
		//	バイオーム画像からブロック、高さ画像を生成する。dst[i] = blk | (y<<16) の形式で返す。
		blkheightfunc = @( bio, dst){
			local w = bio.width, h = bio.height;
			local basey = 3, hscale = 1, hnoise = getrange( gendata["heightnoise"], 1.0);
			local blkmap = blkmap, rnd = rnd;
			return @( x, z, i){
				local b = bio[i], blk = blkmap[b];
				local y = basey * hscale;
				switch( b){
				case FLOOR2:
					if( bio.countUsed( FLOOR2, x-1, z-1, 3, 3) <= 5){
						local bl = bio[i-1], br = bio[i+1], bu = bio[i-w], bd = bio[i+w];
						local c = (bl==FLOOR1) + (br==FLOOR1) + (bu==FLOOR1) + (bd==FLOOR1);	//	とんがったところを潰す。。。
						if( c >= 3){
							blk = blkmap[FLOOR1]; break;
						}
					}
					y += 4;
					break;
				case MOUNTAIN:
					local nm = (bio.countUsed( MOUNTAIN, x-2, z-2, 5, 5) + bio.countUsed( EXMOUNTAIN, x-2, z-2, 5, 5)) * 2.0 / 25.0;
					local ex = bio.countUsed( EXMOUNTAIN, x-1, z-1, 3, 3) * 6;
					ex += (!!bio.countUsed( FLOOR2, x-2, z-2, 5, 5)) * 3;
					local dy = Math.min( 10.0, 4 + (::NoiseGen.value( x*0.15, z*0.15, 13245, 3, 2.0, 0.5) * 8.0 * nm) + ex);
					y += Math.iround( Math.lerp( 10.0, dy, hnoise));
					break;
				case EXMOUNTAIN:
					y += 10;
					break;
				case LAKE2:
					y += 4;
					blk = blkmap[LAKE1];
					break;
				}
				y = Math.iround( y);
				return blk | (y<<16);
			}
		}
	},
	////////////////////////////////////////////////////////////////////////////////////////////////////////
	//	dungeon タイプ。部屋が繋がった洞窟
	{	
		lbl="Dungeon", val="dungeon", 
		halfimg = false,
		//
		props=[
			{ ...sizeprop, defval=[160,160] },
			seedprop,
			//	画像生成パラメータ
			{ pid="largeCellSize", lbl="L-Cell size", type=RANGE, cnt="cnt6.ui", range=(10.0,50.0), q=1, defval=[22.0,38.0] },
			{ pid="mode", lbl="$T.lbl_mode", type=LIST, list=[
				{ lbl="$T.lbl_random", val=_layoutwgt( 0.33, 0.34, 0.33) },
				{ lbl="Hub", val=_layoutwgt( 1.0, 0.0, 0.0) },
				{ lbl="Ring", val=_layoutwgt( 0.0, 1.0, 0.0) },
				{ lbl="Beanch", val=_layoutwgt( 0.0, 0.0, 1.0) },
			], defval=_layoutwgt(0.33, 0.34, 0.33) },
			{ pid="roomRate", lbl="Room Rate", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.25,0.5] },
			{ pid="roomSize", lbl="Room Size", type=RANGE, cnt="cnt6.ui", range=(0.2,2.0), q=100, defval=[0.8,1.2] },
			{ pid="roomMinSize", lbl="Room Min Size", type=RANGE, cnt="cnt6.ui", range=(6.0,20.0), q=1, defval=[10,14] },
			{ pid="roomMaxSize", lbl="Room Max Size", type=RANGE, cnt="cnt6.ui", range=(18.0,48.0), q=1, defval=[28,36] },
			{ pid="roomCountMin", lbl="Room Min Count", type=RANGE, cnt="cnt6.ui", range=(4.0,12.0), q=1, defval=[5,7] },
			{ pid="roomCountMax", lbl="Room Max Count", type=RANGE, cnt="cnt6.ui", range=(10.0,40.0), q=1, defval=[20,28] },
			{ pid="corridorWidth", lbl="Corridor Width", type=RANGE, cnt="cnt6.ui", range=(2.0,8.0), q=1, defval=[4,4] },
			{ pid="loopRate", lbl="Loop Rate", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.2,0.4] },
			{ pid="deadEndRate", lbl="Dead End Rate", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.15,0.25] },
			{ pid="branchTryMultiplier", lbl="Branch Try Multiplier", type=RANGE, cnt="cnt6.ui", range=(0.0,20.0), q=1, defval=[8,12] },
			{ pid="branchFromProtectedChance", lbl="Branch From Protected Chance", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.1,0.3] },
			{ pid="linearWingChance", lbl="Linear Wing Chance", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.28,0.38] },
			{ pid="mirrorXChance", lbl="Mirror X Chance", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.4,0.6] },
			//	ブロック生成パラメータ
			{ pid="doorOpenRate", lbl="Door open rate", type=RANGE, cnt="cnt6.ui", range=(0.0,1.0), q=100, defval=[0.2,0.8] },
		],
		blkmaplist = [
			{ id=FLOOR1, lbl="FLOOR_LV1", type="blk", blkpages=[2,3] },
			{ id=FLOOR2, lbl="FLOOR_LV2", type="blk", blkpages=[2,3] },
			{ id=WALL, lbl="WALL", type="blk", blkpages=[2,3] },
			{ id=SEA, lbl="INNER WALL", type="blk", blkpages=[2,3] },
			{ id=LAKE1, lbl="LAKE", type="blk", blkpages=[8] },
			null,
			{ id=PORTAL_DOOR, lbl="PORTAL_DOOR", type="asset", fbpages=[FB_TREE,FB_ROCK] },
			{ id=PORTAL_OPEN, lbl="PORTAL_OPEN", type="asset", fbpages=[FB_TREE,FB_ROCK] },
		],
		biocolor=[
			_c( 54, 146, 96),		//	FLOOR_LV1
			_c( 216, 128, 56),		//	FLOOR_LV2
			_c( 102, 82, 133),		//	FOREST
			_c( 188, 193, 198),		//	MOUNTAIN
			_c( 112, 118, 126),		//	EXMOUNTAIN
			_c( 56, 86, 214),		//	ROAD
			_c( 170, 128, 68),		//	BRIDGE
			_c( 44, 103, 219),		//	RIVER
			_c( 57, 126, 231),		//	LAKE
			_c( 0, 0, 0),			//	SEA
		],
		bioobjdensmap = {
		},
		objsizemap = {
			[ROCK_S]: 2, [ROCK_M]: 3, [ROCK_L]: 4, [TREE_S]: 3, [TREE_M]: 4, [TREE_L]: 5, [FLOWERS_A]: 1, [FLOWERS_B]: 2, [FLOWERS_C]: 3,
		},
		//	ツールから置き換え可能。MapGenerator定義ごとにある
		blkmap = {
			[FLOOR1]=3|(9<<5), [FLOOR2]=3|(14<<5), 
			[WALL]=3|(16<<5), [SEA]=3|(35<<5),
			[ROAD]=3|(17<<5), [BRIDGE]=3|(34<<5),
			[RIVER]=8|(0<<5), 
			//
			[PORTAL_DOOR]="MA060", [PORTAL_OPEN]="MA061",
		},
		//	バイオーム画像からブロック、高さ画像を生成する。dst[i] = blk | (y<<16) の形式で返す。
		blkheightfunc = @( bio, dst){
			local w = bio.width, h = bio.height;
			local basey = 3, hscale = 1;
			local blkmap = blkmap, rnd = rnd;
			return @( x, z, i){
				local b = bio[i];
				local blk = blkmap[b];
				local y = basey * hscale;
				switch( b){
				case WALL:
				case SEA:
					y += 6;
					break;
				}
				y = Math.iround( y);
				return blk | (y<<16);
			}
		},
		//	
		objgenfunc = @( bio, objbmp){
			local w = bio.width, h = bio.height;
			local blkmap = blkmap, rnd = rnd;
			local wh = w*h;
			local objs = [], dor = getrange( gendata["doorOpenRate"], 0.5);
			for( local l = 0;l < wh; l ++){
				local b = bio[l];
				if( b != BRIDGE) continue;
				local x = l%w, z = l/w;
				if( objbmp.get( x, z)) continue;
				objbmp.set( x, z, 1);
				//	横、縦に4ブロックのBRIDGEが続く場合に、中央にPORTAL_DOORを置く。
				if( bio.countUsed( BRIDGE, x, z, 4, 1) == 4){
					local rot = bio[x+(z-1)*w] == ROAD ? 2 : 0;
					local objid = (rnd( 0.0, 1.0) < dor) ? PORTAL_OPEN : PORTAL_DOOR;
					objs .. { objid=objid, x=x+2, z=z+(rot==2?1:0), rot=rot };	//	回転でずれるな～
				}else
				if( bio.countUsed( BRIDGE, x, z, 1, 4) == 4){
					local rot = bio[x+1+z*w] == ROAD ? 1 : 3;
					local objid = (rnd( 0.0, 1.0) < dor) ? PORTAL_OPEN : PORTAL_DOOR;
					objs .. { objid=objid, x=x+(rot==3?1:0), z=z+2, rot=rot };	//	回転でずれるな～
				}
			}
			return objs;
		}
	}
];



//////////////////////////////////////////////////////////////////////////////
//	MapGenerator
//	mapimggen.exeの出力データを読み込むためのクラス。マップの幅、高さ、バイオーム情報、オブジェクト情報を保持する。

//	ソースの RGBAImage から BlockWorld を作るためのクラス。
//	
// Asset foundations: wood marks the exact asset extent, stone the two-block
// setback. The companion Plan JSON records the selected asset IDs.
local settlementBlocks = [
	2|(1<<5), 2|(7<<5), 2|(27<<5), 3|(16<<5), 3|(35<<5),
	2|(6<<5), 3|(22<<5), 8, 8, 3|(35<<5),
	3|(9<<5), 3|(34<<5), 3|(17<<5), 3|(14<<5), 3|(17<<5),
	8, 2|(24<<5), 2|(27<<5), 3|(17<<5)
];
local settlementLabels = [
	"Ground", "Sand / Fields", "Garden", "Wall", "Inner Wall",
	"Road", "Bridge / Entrance", "River", "Lake", "Outside / Inner Wall",
	"Floor", "Wood Floor", "Stone Floor", "Furniture", "Pavement",
	"Sea", "Cliff", "Trees", "Castle Wall Walk"
];
local townColors = [
	_c(104,146,86), _c(196,168,103), _c(54,122,65), _c(124,90,67),
	_c(77,54,49), _c(154,116,76), _c(218,176,74), _c(60,150,210),
	_c(40,90,180), _c(22,28,38), _c(183,151,96), _c(151,105,66),
	_c(157,157,148), _c(83,61,43), _c(132,126,116), _c(38,103,155),
	_c(100,103,113), _c(25,69,42)
];
local castleColors = [
	_c(128,137,116), _c(190,170,112), _c(76,116,72), _c(126,129,136),
	_c(76,78,87), _c(150,128,94), _c(211,175,72), _c(46,126,198),
	_c(36,78,155), _c(18,22,30), _c(172,153,113), _c(158,119,80),
	_c(177,177,172), _c(89,61,45), _c(160,156,139),
	// These IDs are not emitted by castle; retain unique palette entries.
	_c(38,103,155), _c(100,103,113), _c(25,69,42), _c(139,142,145)
];
local settlementHeight = @( bio, dst){
	local blkmap = blkmap;
	local basey = Math.iround( getrange( gendata["baseyprop"], 3));
	local wallheight = settlementWallHeight;
	// An open castle still has the keep's masonry. The plan already omits
	// the outer curtain when the requested wall height is zero.
	if( gendef.val=="castle" && wallheight==0) wallheight=6;
	return @( x, z, i){
		local b = bio[i], y = basey;
		switch( b){
		case WALL: case INNERWALL: case SEA:
			y += wallheight; break;
		case CASTLE_WALL_WALK:
			y += Math.max( 1, wallheight-1); break;
		case TOWN_FURNITURE:
			y += 2; break;
		case TOWN_CLIFF:
			y += 6; break;
		case TOWN_TREES:
			break;
		case RIVER: case LAKE: case TOWN_SEA:
			y = Math.max( 0, basey-1); break;
		}
		return blkmap[b] | (y<<16);
	}
};
foreach( t in ["village", "town", "castle"]){
	local props = [ { ...sizeprop, range=t=="castle" ? (128,1024) : (64,1024), defval=[160,160] } ];
	if( t == "castle") props .. { pid="mode", lbl="$T.mapgen_castletype", type=LIST, list=[
		{ lbl="$T.lbl_random", val={} },
		{ lbl="$T.mapgen_castleconcentric", val={castleMode=0} },
		{ lbl="$T.mapgen_castlehill", val={castleMode=1} },
		{ lbl="$T.mapgen_castleriver", val={castleMode=2} },
		{ lbl="$T.mapgen_castlepalace", val={castleMode=3} },
		{ lbl="$T.mapgen_castlefortress", val={castleMode=4} }
	], defval={} };
	foreach( prop in [
		{ ...baseyprop, defval=[3,3] },
		{ pid="wallHeight", lbl="$T.mapgen_wallheight", type=RANGE, cnt="cnt6.ui", range=(0,16), q=1, defval=t=="castle" ? [6,6] : [0,0] },
		{ pid="assetPlotCount", lbl="$T.mapgen_buildings", type=RANGE, cnt="cnt6.ui", range=(1,128), q=1, defval=t=="village" ? [12,24] : [20,36] },
		{ pid="assetRoadWidth", lbl=t!="castle" ? "$T.mapgen_basepathwidth" : "$T.mapgen_roadwidth", type=RANGE, cnt="cnt6.ui", range=(2,6), q=1, defval=[2,2] },
		{ pid="candidateCount", lbl="$T.mapgen_candidates", type=RANGE, cnt="cnt6.ui", range=(1,12), q=1, defval=[6,6] }
	]) props .. prop;
	props .. { pid="countryWealth", lbl="$T.mapgen_wealth", type=RANGE, cnt="cnt6.ui", range=(0.7,2.5), q=20, defval=[0.7,2.5] };
	props .. { pid="northFacingHouseKeepPercent", lbl="$T.mapgen_northhousekeep", type=RANGE, cnt="cnt6.ui", range=(0,100), q=1, defval=[10,10] };
	props .. { pid="sideFacingHouseKeepPercent", lbl="$T.mapgen_sidehousekeep", type=RANGE, cnt="cnt6.ui", range=(0,100), q=1, defval=[75,75] };
	props .. { pid="naturalDecorationDensity", lbl="$T.mapgen_naturedensity", type=RANGE, cnt="cnt6.ui", range=(0,100), q=10, defval=[1.0,3.0] };
	if( t == "castle"){
		props .. { pid="outerWallDefenseStrength", lbl="$T.mapgen_castledefense", type=RANGE, cnt="cnt6.ui", range=(0,2), q=20, defval=[0,2] };
		props .. { pid="keepWidthRatio", lbl="$T.mapgen_castlewidthratio", type=RANGE, cnt="cnt6.ui", range=(0.25,0.55), q=20, defval=[0.3,0.45] };
		props .. { pid="keepDepthRatio", lbl="$T.mapgen_castledepthratio", type=RANGE, cnt="cnt6.ui", range=(0.15,0.4), q=20, defval=[0.2,0.3] };
		props .. { pid="gateCount", lbl="$T.mapgen_castlegates", type=RANGE, cnt="cnt6.ui", range=(1,3), q=1, defval=[1,3] };
		props .. { pid="towerCount", lbl="$T.mapgen_castletowers", type=RANGE, cnt="cnt6.ui", range=(4,12), q=1, defval=[4,8] };
		props .. { pid="keepRoomCount", lbl="$T.mapgen_castlerooms", type=RANGE, cnt="cnt6.ui", range=(4,32), q=1, defval=[4,12] };
		props .. { pid="outerFacilityCount", lbl="$T.mapgen_castlefacilities", type=RANGE, cnt="cnt6.ui", range=(4,32), q=1, defval=[4,12] };
		props .. { pid="outerFacilityDensity", lbl="$T.mapgen_castlefacilitydensity", type=RANGE, cnt="cnt6.ui", range=(0.5,3), q=10, defval=[1,3] };
		props .. { pid="moatWidth", lbl="$T.mapgen_castlemoat", type=RANGE, cnt="cnt6.ui", range=(2,5), q=1, defval=[2,5] };
		props .. { pid="wallThickness", lbl="$T.mapgen_castlewallthickness", type=RANGE, cnt="cnt6.ui", range=(1,3), q=1, defval=[1,3] };
		props .. { pid="mainRoadWidth", lbl="$T.mapgen_castlemainwidth", type=RANGE, cnt="cnt6.ui", range=(3,5), q=1, defval=[3,5] };
		props .. { pid="roadExtraEdgeRate", lbl="$T.mapgen_castleconnections", type=RANGE, cnt="cnt6.ui", range=(0,1), q=20, defval=[0.1,0.3] };
		props .. { pid="castlePaving", lbl="$T.mapgen_castlepaving", type=LIST, list=[
			{lbl="$T.lbl_random",val={}}, {lbl="$T.mapgen_pavinglow",val={pavingRatio=0.2}},
			{lbl="$T.mapgen_pavingmedium",val={pavingRatio=0.5}}, {lbl="$T.mapgen_pavinghigh",val={pavingRatio=0.85}}
		],defval={} };
	}else{
		props .. { pid="terrainRelief", lbl="$T.mapgen_relief", type=RANGE, cnt="cnt6.ui", range=(0,12), q=1, defval=[2.0,4.0] };
		props .. { pid="villageMainRoadCount", lbl="$T.mapgen_mainroads", type=RANGE, cnt="cnt6.ui", range=(0,4), q=1, defval=t=="village" ? [1,4] : [2,4] };
		props .. { pid="orientation", lbl="$T.mapgen_orientation", type=LIST, list=[
			{ lbl="$T.lbl_random", val={} },
			{ lbl="0°", val={siteRotation=0} }, { lbl="90°", val={siteRotation=1} },
			{ lbl="180°", val={siteRotation=2} }, { lbl="270°", val={siteRotation=3} }
		], defval={} };
		props .. { pid="site", lbl="$T.mapgen_site", type=LIST, list=[
			{ lbl="$T.lbl_random", val={} },
			{ lbl="Plains", val={settlementSite=0} },
			{ lbl="Coast", val={settlementSite=1} },
			{ lbl="Mountain Valley", val={settlementSite=2} },
			{ lbl="Forest", val={settlementSite=3} },
			{ lbl="River", val={settlementSite=4} },
			{ lbl="Lake", val={settlementSite=5} },
			{ lbl="Oasis", val={settlementSite=6} }
		], defval={} };
		if( t == "town"){
			props .. { pid="city", lbl="$T.mapgen_city", type=LIST, list=[
				{ lbl="$T.lbl_random", val={} },
				{ lbl="Medieval City", val={townCityType=0} },
				{ lbl="Castle Town", val={townCityType=1} },
				{ lbl="Paved City", val={townCityType=2} },
				{ lbl="Walled City", val={townCityType=3} }
			], defval={} };
		}
	}
	local blkmap = {}, blkmaplist = [];
	local colors = t == "castle" ? castleColors : townColors;
	foreach( id, color in colors){
		blkmap[id] <- settlementBlocks[id];
		if( t=="castle" && (id==INNERWALL || id==SEA)) blkmap[id] = settlementBlocks[WALL];
		blkmaplist .. { id=id, lbl=settlementLabels[id], type="blk",
			blkpages=(id==RIVER || id==LAKE || id==TOWN_SEA) ? [8] : [2,3] };
	}
	::MapGenerators .. {
		lbl=t=="town" ? "Town" : (t=="village" ? "Village" : "Castle"), val=t,
		halfimg=false, settlement=true, props=props,
		biocolor=colors, blkmap=blkmap, blkmaplist=blkmaplist,
		bioobjdensmap={}, objsizemap={}, blkheightfunc=settlementHeight
	};
}

class MapGenerator
{
	//	入力パラメータ
	srcw = 128;
	srcd = 128;
	seed = 123125;
	gendef = null;				//	MapGenerators[i]: マップ生成定義
	gendata = null;				//	生成パラメータ。gendef.propsのプロパティ。
	blkmap = null;				//	バイオームID、オブジェクトIDからブロックIDへのマップ
	tmpdir = "tmp";				//	src画像の一時保存先ディレクトリ。
	//	ステート
	src = null;					//	RGBAImage: 1/2サイズの普通のカラー画像。mapimggen.exeで生成する。
	rnd = null;					//	Random: 乱数生成器
	//	生成結果
	dst = null;					//	RGBAImage: srcから生成するフルサイズのマップ画像。blk(8), hight(8), fblk(8)
	objs = null;				//	樹木などオブジェクトのリスト。MapGenerationDataのobjsと同じ。
	settlementWallHeight = 0;
	assetPlan = null;
	assetParameters = null;

	// Read the live map_asset.json resource through the same decoder as asset
	// placement. Full BlockWorld extents include roofs and projecting details.
	function constructionAssetDoor( bw){
		local best = null, score = 1000000;
		foreach( fb in bw.collectFreeBlocks( IRect3D( 0,0,0,bw.w,bw.h,bw.d), [])){
			if( !fb.isClass( "door")) continue;
			local br = fb.br;
			local distances = [bw.d-1-fb.z, bw.w-1-fb.x, fb.z, fb.x];
			for( local side = 0;side < 4;side++){
				if( br.w > br.d && (side&1)) continue;
				if( br.d > br.w && !(side&1)) continue;
				local s = distances[side] + fb.y*0.01;
				if( s < score){
					score = s;
					best = { x=Math.clamp( int(br.x+br.w*0.5)-1, 0, bw.w-2), z=Math.clamp( int(br.z+br.d*0.5)-1, 0, bw.d-2), side=side };
				}
			}
		}
		// Deep interior doors do not identify a street-facing entrance.
		return score < 4.5 ? best : null;
	}

	function constructionAssetName( asset){
		local name=asset["name"],text="";
		if( typeof(name)==SS_TABLE){ foreach( lang,label in name) text=text .. label .. " "; }
		else if( name) text=name;
		return text;
	}
	function constructionAssetLimitGroup( text){
		foreach( word in ["教会","神殿","寺院","church","Church","temple","Temple"])
			if( text.contains(word)) return 1;
		foreach( word in ["城","宮殿","castle","Castle","palace","Palace"])
			if( text.contains(word)) return 2;
		return 0;
	}
	function constructionAssetParameters(){
		local count = 0, buildingCount = 0, parameters = {};
		local assets = ::conf._resource.map_asset;
		foreach( aid in Table.keys( assets).sort()){
			if( !aid.startsWith( "MA")) continue;
			local asset = assets[aid], text = constructionAssetName(asset);
			local category = -1;
			foreach( word in ["家", "屋敷", "ショップ", "倉庫", "アパート", "教会", "宿", "店", "城", "house", "House", "shop", "Shop", "warehouse", "Warehouse", "apartment", "Apartment", "church", "Church", "castle", "Castle"]){
				if( text.contains( word)){ category = 0; break; }
			}
			local limitGroup=constructionAssetLimitGroup(text);
			local residential=false;
			foreach(word in ["家","屋敷","house","House","manor","Manor","mansion","Mansion","residence","Residence"])
				if(text.contains(word)) residential=true;
			foreach(word in ["ショップ","倉庫","アパート","宿","店","shop","Shop","warehouse","Warehouse","apartment","Apartment"])
				if(text.contains(word)) residential=false;
			if(limitGroup>0) residential=false;
			if( category<0 && limitGroup>0) category=0;
			if( text.contains( "橋") || text.contains( "bridge") || text.contains( "Bridge")) category = 1;
			if( text.contains( "城壁") || text.contains( "wall") || text.contains( "Wall")) category = 2;
			if( category < 0 || !asset["bw64"]) continue;
			local bw = objbw( aid), id = 0;
			for( local i = 2;i < length( aid);i++) id = id*10 + aid[i]-'0';
			local growing = category==0;
			local door = growing ? constructionAssetDoor( bw) : null;
			if( growing && !door){
				printf( "Settlement skipped asset without an exterior door: %S\n", aid);
				continue;
			}
			for( local rot = 0;rot < (growing ? 4 : 1);rot++){
				local m = IMat().rotate( rot);
				local bounds = IRect3D( 0,0,0,bw.w,bw.h,bw.d).transform( m);
				local key = "asset" .. count;
				parameters[key .. "Id"] <- id;
				parameters[key .. "Width"] <- bounds.w;
				parameters[key .. "Depth"] <- bounds.d;
				parameters[key .. "Category"] <- category;
				parameters[key .. "Residential"] <- residential?1:0;
				parameters[key .. "Rotation"] <- rot;
				parameters[key .. "LimitGroup"] <- limitGroup;
				parameters[key .. "MaxCount"] <- limitGroup>0 ? 1 : 0;
				if( door){
					local opening = IRect3D( door.x,0,door.z,2,1,2).transform( m);
					local normal = [(0,0,1),(1,0,0),(0,0,-1),(-1,0,0)][door.side];
					local n = m.transform( normal);
					parameters[key .. "DoorX"] <- opening.x-bounds.x;
					parameters[key .. "DoorY"] <- bounds.d-2-(opening.z-bounds.z);
					parameters[key .. "DoorSide"] <- n[2]>0 ? 0 : (n[0]>0 ? 1 : (n[2]<0 ? 2 : 3));
				}
				count++;
				if( category==0) buildingCount++;
			}
		}
		if( !count) throw Exception( "No construction assets found in map_asset.json");
		if( !buildingCount)
			throw Exception( "No settlement building assets have an identifiable exterior door. Check the skipped asset IDs in the log.");
		parameters.assetCount <- count;
		parameters.assetFoundation <- 1;
		parameters.settlementCivicPlan <- 1;
		// FreeBlock family IDs, distinct from the FB_* category bitmasks.
		foreach(kind,variants in {[3]=[11,14,26],[4]=[5],[2]=[1]}) foreach(variant in variants){
			local br=FreeBlock.create({fbtype:kind,fbparam:variant,pos:[0,0,0]}).br;
			local key="civicObject" .. kind .. "_" .. variant;
			parameters[key .. "Width"] <- br.w;parameters[key .. "Depth"] <- br.d;parameters[key .. "Height"] <- br.h;
		}
		if( gendef.val=="castle"){
			foreach( kind,variants in { [1]=[8,13], [2]=[4,7], [4]=[4,5,7,9,10,11,14,15,21,23,28,30,31,33,34,35,40,41] }){
				foreach( variant in variants){
					local br=FreeBlock.create({fbtype:kind,fbparam:variant}).br;
					local key="castleObject" .. kind .. "_" .. variant;
					parameters[key .. "Width"] <- br.w;parameters[key .. "Depth"] <- br.d;parameters[key .. "Height"] <- br.h;
				}
			}
		}
		return parameters;
	}
	
	//	mapimggen.exeをpopen実行して、src画像を生成する。
	//	generate()の前に読んでおく。
	function generateSourceImage(){
		rnd = Random( seed, 11);
		local exe = FileRef( "tools/mapimggen.exe");
		local outid = "%x" % seed;
		local p = popen_s();
		local args = [];
		local wdiv = gendef.halfimg ? 2 : 1;
		args .. "-type" .. gendef.val .. "-w" .. (srcw/wdiv) .. "-d" .. (srcd/wdiv);
		args .. "-dir" .. tmpdir .. "-out" .. outid .. "-seed" .. seed;
		local parameters = clone gendata;
		if( gendef["settlement"]){
			settlementWallHeight = getargrange( "wallHeight", gendata["wallHeight"]);
			parameters["wallHeight"] <- settlementWallHeight;
		}
		local numeric = gendef["settlement"] ? constructionAssetParameters() : null;
		parseopts( parameters, args, numeric);
		if( gendef["settlement"]){
			local paramfile = `$tmpdir/${outid}_params.json`;
			assetParameters = numeric;
			local bb = encodeJSON( numeric, 0, ByteBuffer());
			bb.pos = 0;
			FileRef( paramfile).save( bb);
			args.extend( ["--plan", "--strict", "--params-file", paramfile]);
		}
		printf( "MapGenerator args: %S\n", encodeJSON( args));
		local output = [], exitcode;
		local readoutput = @(){
			for( local line; line = p.readLine();){
				printf( "MapGenerator output: %S\n", line);
				if( output.len() < 32) output.push( line);
			}
		};
		try{
			p.open( exe, args, 0x300);	// Pipe output and hide the console.
			while( p.isrunning()){
				readoutput();
				suspend();
			}
			readoutput();
			exitcode = p.exitcode();
			p.close();
		}catch( ex){
			if( p.isrunning()) p.kill();
			p.close();
			throw ex;
		}
		if( exitcode) throw Exception( "Map generation failed: type=%S seed=%S exit=%S\n%S" % (gendef.val, seed, exitcode, output.join("\n")));
		if( gendef["settlement"]){
			local planfile = FileRef( `$tmpdir/${outid}_plan.json`);
			if( !planfile.exists()) throw Exception( "Map generation did not output the asset plan. See MapGenerator args in the log.");
			assetPlan = decodeJSON( planfile.load());
			if( !assetPlan || assetPlan["seed"] != seed ||
				!assetPlan["biomes"] || assetPlan.biomes.len() != srcw*srcd ||
				!assetPlan["regions"]){
				throw Exception( "Invalid map plan: type=%S seed=%S" % (gendef.val, seed));
			}
		}
		local png = FileRef( `$tmpdir/${outid}.png`).load();
		local image = skLoadImage( png);
		if( !image || image.width != srcw/wdiv || image.height != srcd/wdiv){
			throw Exception( "Invalid map image: type=%S seed=%S" % (gendef.val, seed));
		}
		return src = image;
	}

	//	マップ生成処理を開始する。入力パラメータが全て設定された状態で呼ぶ必要がある。
	function generate(){
		if( !src) src = generateSourceImage();
		// Preview resources may be released and rebuilt after switching maps.
		// Restart decoration/height randomness so a retry reproduces this seed.
		rnd = Random( seed, 11);
		local srcrev = flipY( src);
		//	まずはbio画像を作る。biocolorを使って、srcの色からバイオームIDを取得する。
		local bio = ImageColorGroups.toIndexImage( gendef.biocolor, srcrev, RGBAImage( srcrev.width, srcrev.height));
		//	halfimg指定の場合は、bioを倍サイズ化する。この時に、川や道路の境界を滑らかにする処理が入る。
		if( gendef.halfimg){
			bio = zoomBiomeImage( bio);
		}
		//	次にフリーブロックを配置していく => 後回し！
		objs = generateObjects( bio);
		//	バイオームからブロック、高さを決定する。
		dst = generateBlockHeightImage( bio);
	}

	function flipY( img){
		local w = img.width, h = img.height;
		local dst = RGBAImage( w, h), a = [];
		for( local z = 0; z < h;z ++){
			img.getRow( h-1-z, a);
			dst.setRow( z, a);
		}
		return dst;
	}

	function getrange( r, defval=0.0){
		if( !r) return defval;
		return rnd( r[0], r[1]);
	}

	function parseopts( tb, args, numeric=null){
		foreach( i in Table.keys( tb).sort()){	//	キーでソートしてrndの再現性が出るようにする。
			local v = tb[i], f;
			// Count/width ranges describe a generation interval, not one sampled count.
			if( numeric && typeof(v)==SS_ARRAY && (i=="gateCount" || i=="towerCount" || i=="keepRoomCount" || i=="outerFacilityCount" || i=="moatWidth")){
				numeric[i.."Min"] <- Math.iround(Math.min(v[0],v[1]));
				numeric[i.."Max"] <- Math.iround(Math.max(v[0],v[1]));
				continue;
			}
			if( numeric && (i=="size" || i=="baseyprop")) continue;
			if( v["notarg"]) continue;	//	コマンドライン引数にしないプロパティ
			switch( typeof( v)){
			case SS_TABLE: parseopts( v, args, numeric); continue;	//	再帰的にparseoptsする。
			case SS_ARRAY: f = getargrange( i, v); break;
			default: f = v; break;
			}
			if( numeric) numeric[i] <- f;
			else args.extend( ["-p", "%S=%S" % (i,f)]);
		}
	}

	function getargrange( pid, range){
		local prop = gendef.props.find( @( p) p.pid==pid);
		if( prop && prop["q"]==1){
			// Integer controls include both endpoints, even after UI float storage.
			local lo=Math.iceil(Math.min(range[0],range[1]));
			local hi=Math.ifloor(Math.max(range[0],range[1]));
			return rnd( lo, hi+1);
		}
		return getrange( range);
	}

	//	オブジェクトを配置する。配置済みのオブジェクトはobjbmpに記録する。
	//	
	function generateObjects( bio){
		local objs = [];
		// Settlement PNGs already contain vegetation and furniture footprints.
		if( gendef["settlement"]) return objs;
		local w = bio.width, h = bio.height;
		local d0 = [getrange( gendata["rockdens"]), getrange( gendata["treedens"]), getrange( gendata["flowerdens"]), getrange( gendata["treedens"])];
		local objbmp = Bitmap( bio.width, bio.height);	//	配置済みのオブジェクトを記録する。1x1のオブジェクトは1x1、2x2のオブジェクトは2x2の領域に配置済みフラグを立てる。
		local bioobjdensmap = gendef.bioobjdensmap;
		//////// タイプ毎処理
		local fn = gendef["objgenfunc"];
		if( fn){
			objs ... fn( bio, objbmp);
		}
		//////// 共通処理
		//	
		local pens = #[
			Bitmap( 1, 1, 1),	//	0
			Bitmap( 1, 1, 1),	//	1x1
			Bitmap( 2, 2, 1),	//	2x2
			Bitmap( 3, 3, 1),	//	3x3
			Bitmap( 4, 4, 1),	//	4x4
			Bitmap( 5, 5, 1),	//	5x5
			Bitmap( 6, 6, 1),	//	6x6
		];
		//
		for( local z = 0;z < h;z += 32){
			for( local x = 0;x < w;x += 32){
				//	RGBAImageの指定した領域に存在する色の数を数える。これで、16x16の中に何種類のバイオームが存在するかが分かる。
				local biocntmap = bio.countColorMap( {}, x, z, 32, 32);
				local objcntmap = {};
				local trycnt = 0;
				//	PLAINからEXMOUTAIN
				for( local l = 0;l < 5;l ++){
					local biocnt = biocntmap[l];
					if( !biocnt) continue;	//	このバイオームは16x16の中に存在しない。
					local m = bioobjdensmap[l], t = {};
					foreach( i, v in m){
						local n = Math.iround( v * (d0[(i-20)/3]||0.0) * biocnt * rnd( 0.7, 1.0) * 0.03 );
						if( n){
							t[i] <- n;
							trycnt += n;
						}
					}
					if( length( t)) objcntmap[l] <- t;
				}
				trycnt = trycnt * 2;	//	配置失敗を加味して2倍の試行回数
				
				/////////////////////////////////////////////////////////////////////////////////
				//	試行開始！
				//	
				for( local l = 0;l < trycnt;l ++){
					local tx = x+rnd( 0, 32), tz = z+rnd( 0, 32);
					local b = bio[tx + tz*w];
					local t = objcntmap[b];
					foreach( i, n in t){
						local sz = gendef.objsizemap[i], hs = sz/2;
						if( objbmp.countSet( tx-hs, tz-hs, sz, sz)){
							continue;	//	既に配置済みのオブジェクトがある。
						}
						if( bio.countUsed( b,tx-hs, tz-hs, sz, sz) < (sz*sz*4/5)) continue; //	バイオームが一様でない場合も配置失敗
						//	配置する
						objs .. { objid=i, x=tx, z=tz, rot=rnd( 0, 3), size=sz};
						objbmp.draw( pens[sz], tx-hs, tz-hs);
						if( (t[i]=n-1) <= 0) delete t[i];
						break;
					}
				}
			}
		}
		return objs;
	}

	//	バイオーム画像を2倍に拡大する。拡大時に、川や道路の境界を滑らかにする。
	//	
	function zoomBiomeImage( bio){
		local w = bio.width, h = bio.height;
		local win = RGBAImage( 3, 3, 0);	//	3x3の窓で、周囲のバイオームを見て、境界を滑らかにする。
		local bio2 = RGBAImage( w*2, h*2, 0);
		local di = (0,w*2,w*2+1,1);	//	時計回り
		local b4 = (0,0,0,0);
		local fn = gendef.zoomfunc();
		win.draw( bio, 0, 0);
		for( local z = 0, i = 0;z < h;z ++){
			for( local x = 0;x < w;x ++, i++){
				local c = bio[i], xz = x*2 + z*4*w;
				//	周囲のバイオームを見て、境界を滑らかにする。
				win.draw( bio, -x+1, -z+1);
				fn( win, b4);
				// printf( "%S %S => %S\n", x, z, win[4]);
				bio2[xz+di[0]] = b4[0];
				bio2[xz+di[1]] = b4[1];
				bio2[xz+di[2]] = b4[2];
				bio2[xz+di[3]] = b4[3];
			}
		}
		return bio2;
	}

	//	バイオーム画像から、ブロックと高さを決定する。dstのバイオームチャンネルと高さチャンネルに書き込む。
	function generateBlockHeightImage( bio){
		local w = bio.width, h = bio.height;
		local dst = RGBAImage( w, h);
		local fn = gendef["blkheightfunc"];
		fn = fn( bio, dst);
		for( local z = 0, i = 0;z < h;z ++){
			for( local x = 0;x < w;x ++, i++){
				local block = fn( x, z, i);
				if( gendef["settlement"] && assetPlan && assetPlan["heightOffsets"] && assetPlan.heightOffsets.len() == w*h){
					local offset = assetPlan.heightOffsets[(h-1-z)*w+x];
					block += offset<<16;
				}
				if( gendef["settlement"] && assetPlan && assetPlan["shoreCuts"] && assetPlan.shoreCuts.len() == w*h){
					local cut = assetPlan.shoreCuts[(h-1-z)*w+x];
					local height = Math.max( 0,(block>>>16)-cut);
					block = (block&0xffff)|(height<<16);
				}
				dst[i] = block;
			}
		}
		return dst;
	}

	function objbw( objid){
		local ba = ::conf._resource.map_asset[objid];
		if( !ba["bw64"]) return null;
		local bb = uncompressZSTD( decodeBASE64( ba.bw64));
		return ObjectInput.decode( bb);
	}

	// Plan coordinates start at the PNG's top left. BlockWorld uses the
	// opposite Z direction. Place native asset bounds directly in each plot;
	// plcoffs is a manual cursor offset, not an offset from the asset bounds.
	function placeConstructionAssets( bw){
		if( !assetPlan) return;
		local cache = {}, placements = [], facilityCounts={};
		if( gendef.val=="castle") facilityCounts[2] <- 1; // The generated keep is the royal residence.
		foreach( plot in assetPlan.regions){
			if( plot.kind != "asset_plot") continue;
			local aid = plot.role;
			local asset = ::conf._resource.map_asset[aid];
			if( !asset || !asset["bw64"]) throw Exception( "Construction asset is missing: " .. aid);
			local aw = cache[aid] ?? (cache[aid] <- objbw( aid));
			local x = plot.x0, z = bw.d-1-plot.y1;
			local rot = plot["rotation"] ?? 0;
			local entrance=constructionAssetDoor(aw);
			if( !entrance) throw Exception("Construction asset exterior door changed: " .. aid);
			local normal=IMat().rotate(rot).transform([(0,0,1),(1,0,0),(0,0,-1),(-1,0,0)][entrance.side]);
			if( Math.max(aw.w,aw.d)>12 && normal[0]!=0)
				throw Exception( "Only houses up to 12 blocks may face sideways: " .. aid);
			local group=constructionAssetLimitGroup(constructionAssetName(asset));
			if( group>0){
				if( facilityCounts[group]) throw Exception("Duplicate unique settlement facility: " .. aid);
				facilityCounts[group] <- 1;
			}
			local bounds = IRect3D( 0,0,0,aw.w,aw.h,aw.d).transform( IMat().rotate( rot));
			if( bounds.w != plot.x1-plot.x0+1 || bounds.d != plot.y1-plot.y0+1)
				throw Exception( "Construction asset size changed. Generate the map again: " .. aid);
			if( x < 0 || z < 0 || x+bounds.w > bw.w || z+bounds.d > bw.d)
				throw Exception( "Construction asset is outside the map: " .. aid);
			local ground = dst[x + z*bw.w]>>>16;
			for( local dz = 0;dz < bounds.d;dz++) for( local dx = 0;dx < bounds.w;dx++){
				if( (dst[x+dx + (z+dz)*bw.w]>>>16) != ground)
					throw Exception( "Construction asset requires level ground: " .. aid);
			}
			local y = ground+1;
			if( y+aw.h > bw.h) throw Exception( "Construction asset is too tall for the map: " .. aid);
			placements.push( { asset=aw, matrix=IMat( x-bounds.x,y,z-bounds.z).rotate( rot), air=asset["plcair"]?1:0 });
		}
		// Validate every placement first, then merge voxels and free blocks.
		foreach( p in placements) bw.drawWorld( p.asset, p.matrix, p.air);
	}

	function placeCastleDoors( bw){
		if( gendef.val!="castle" || !assetPlan) return;
		local placed=[],fb=FreeBlock.create({fbtype:FB_EXDOOR,fbparam:16}),br=fb.br;
		foreach( r in assetPlan.regions){
			if( r.kind!="castle_front_door") continue;
			if( r.x1-r.x0+1!=br.w || r.y1-r.y0+1<br.d)
				throw Exception("Castle gate dimensions do not match the reserved opening");
			local x=r.x0,z=bw.d-1-r.y1,ground=dst[x+z*bw.w]>>>16,y=ground+1;
			// Clear the complete opening and frame the existing, unlocked gate.
			bw.fillBlock(IRect3D(x,y,z,br.w,br.h,2),0);
			local stone=blkmap[WALL];
			bw.fillBlock(IRect3D(x-1,y,z,1,br.h+1,2),stone);
			bw.fillBlock(IRect3D(x+br.w,y,z,1,br.h+1,2),stone);
			bw.fillBlock(IRect3D(x-1,y+br.h,z,br.w+2,1,2),stone);
			bw.placeFreeBlock(FB_EXDOOR,16,IPos(x-br.x,y-br.y,z-br.z,0),0);
			local found=false;
			foreach( actual in bw.collectFreeBlocks(IRect3D(x,y,z,br.w,br.h,2),[]))
				if( actual.fbtype==FB_EXDOOR && (actual.fbparam&0x3ff)==16) found=true;
			if( !found) throw Exception("Castle great gate was not placed");
			placed.push({x:x,y:y,z:z,width:br.w,height:br.h,fbtype:FB_EXDOOR,fbparam:16});
		}
		local report=encodeJSON({seed:assetPlan.seed,doors:placed,wallBlock:blkmap[WALL],innerWallBlock:blkmap[INNERWALL]},0,ByteBuffer());
		report.pos=0;FileRef("tmp/mapgen/last_castle_doors.json").save(report);
	}
	
	//	generateを実行した後に、dstのバイオームチャンネルと高さチャンネル、オブジェクトリストからBlockWorldを作る。
	//	
	function placeCastleInterior( bw){
		if( gendef.val!="castle" || !assetPlan) return;
		local fixtures=[],doors=[],details=[],surfaces=[],rooms=[],portals=[],clearances=[];
		foreach( r in assetPlan.regions){
			if( r.kind=="room" || r.kind=="castle_activity") rooms.push({id:r.id,role:r.role,x0:r.x0,y0:r.y0,x1:r.x1,y1:r.y1});
			if( r.kind=="castle_clearance") clearances.push({role:r.role,parentIndex:r.parentIndex,x0:r.x0,y0:r.y0,x1:r.x1,y1:r.y1});
			if( r.kind=="castle_portal"){
				local door=assetPlan.regions[r.parentIndex],dz=bw.d-1-door.y1;
				local ground=dst[door.x0+dz*bw.w]>>>16,x=r.x0,z=bw.d-1-r.y1;
				bw.fillBlock(IRect3D(x,ground+1,z,r.x1-r.x0+1,r.objectHeight,r.y1-r.y0+1),blkmap[WALL]);
				portals.push({parentIndex:r.parentIndex,x:x,y:ground+1,z:z,width:r.x1-r.x0+1,depth:r.y1-r.y0+1,height:r.objectHeight,block:blkmap[WALL]});
			}
			if( r.kind!="castle_surface") continue;
			for( local yy=r.y0;yy<=r.y1;yy++) for( local xx=r.x0;xx<=r.x1;xx++){
				local z=bw.d-1-yy,ground=dst[xx+z*bw.w]>>>16;
				if( r.role=="royal_carpet"){
					// Carpet is a thin overlay; replacing the supporting floor
					// embeds the mesh in the floor instead of laying it on top.
					bw.placeBlock((xx,ground+1,z),9,0);
					if(!Block.isClass(bw.blockat(xx,ground+1,z),"carpet") || !(Block.getFlags(bw.blockat(xx,ground,z))&BLK_SOLID))
						throw Exception("Royal carpet is missing its supporting floor");
				}
				else if( r.role=="ballroom_floor") bw.placeBlock((xx,ground,z),3|(34<<5),0);
				else if( r.role=="drill_yard") bw.placeBlock((xx,ground,z),blkmap[ROAD],0);
			}
			surfaces.push({role:r.role,parentIndex:r.parentIndex,x0:r.x0,y0:r.y0,x1:r.x1,y1:r.y1});
		}
		foreach( r in assetPlan.regions){
			if( r.kind!="castle_fixture" && r.kind!="castle_door" && r.kind!="castle_detail") continue;
			local x=r.x0,z=bw.d-1-r.y1,ground=dst[x+z*bw.w]>>>16,y=ground+1;
			if( r.kind=="castle_detail") y+=assetPlan.regions[r.parentIndex].objectHeight;
			local width=r.x1-r.x0+1,depth=r.y1-r.y0+1,rot=r.rotation;
			for( local dz=0;dz<depth;dz++) for( local dx=0;dx<width;dx++)
				if( (dst[x+dx+(z+dz)*bw.w]>>>16)!=ground) throw Exception("Castle fixture ground is uneven: " .. r.role);
			local actualBounds=null;
			if( r.objectType==-2){
				// Straw practice dummy: two legs, broad wooden arms and a straw head.
				local wood=3|(34<<5),straw=blkmap[DESERT];
				bw.fillBlock(IRect3D(x+1,y,z,2,2,1),wood);
				bw.fillBlock(IRect3D(x,y+2,z,4,1,1),wood);
				bw.fillBlock(IRect3D(x+1,y+3,z,2,2,2),straw);
				if( !bw.blockat(x,y+2,z) || !bw.blockat(x+1,y+4,z+1)) throw Exception("Training dummy was not built");
				actualBounds=IRect3D(x,y,z,4,5,2);
			}else{
				local fb=FreeBlock.create({fbtype:r.objectType,fbparam:r.objectVariant,pos:[0,0,0],rot:rot});
				local bounds=IRect3D(fb.br);
				if( (r.kind=="castle_door" ? (bounds.w>width || bounds.d>depth) : (bounds.w!=width || bounds.d!=depth)) || bounds.h!=r.objectHeight)
					throw Exception("Castle fixture size changed: " .. r.role);
				if( r.kind=="castle_door"){
					bw.fillBlock(IRect3D(x,y,z,width,bounds.h,depth),0);
					// A stone reveal and lintel join the thin wooden leaf to the
					// full wall thickness. The jamb footprints are reserved in Plan.
					local lintel=(rot&1) ? IRect3D(x-1,y+bounds.h,z,width+2,1,depth) : IRect3D(x,y+bounds.h,z-1,width,1,depth+2);
					bw.fillBlock(lintel,blkmap[WALL]);
					bw.fillBlock(IRect3D(x,ground,z,width,1,depth),blkmap[TOWN_STONE_FLOOR]);
				}
				else for( local dz=0;dz<depth;dz++) for( local dx=0;dx<width;dx++) for( local dy=0;dy<bounds.h;dy++){
					local block=bw.blockat(x+dx,y+dy,z+dz);
					if( block && ::Block.getFlags(block)&BLK_SOLID) throw Exception("Castle fixture is obstructed: " .. r.role);
				}
				local positioned=FreeBlock.create({fbtype:r.objectType,fbparam:r.objectVariant,pos:[x-bounds.x,y-bounds.y,z-bounds.z],rot:rot});
				bw.placeFreeBlock(positioned);
				foreach( placed in bw.collectFreeBlocks(IRect3D(x,y,z,width,bounds.h,depth),[])){
					local b=placed.br;
					if( placed.fbtype==r.objectType && (placed.fbparam&0x3ff)==r.objectVariant && b.x==x && b.z==z && b.y==y) actualBounds=b;
				}
				if( !actualBounds){
					local observed=[];
					foreach( actual in bw.collectFreeBlocks(IRect3D(x-4,y-4,z-4,width+8,bounds.h+8,depth+8),[])){
						local b=actual.br;observed.push({type:actual.fbtype,variant:actual.fbparam,x:b.x,y:b.y,z:b.z,w:b.w,h:b.h,d:b.d});
					}
					local diagnostic=encodeJSON({role:r.role,rotation:rot,x:x,y:y,z:z,expected:[width,bounds.h,depth],localBounds:[bounds.x,bounds.y,bounds.z],observed:observed},0,ByteBuffer());
					diagnostic.pos=0;FileRef("tmp/mapgen/castle_fixture_failure.json").save(diagnostic);
					printf("Castle fixture mismatch %S rotation %d expected %S\n",r.role,rot,IRect3D(x,y,z,width,bounds.h,depth));
					foreach( actual in bw.collectFreeBlocks(IRect3D(x-4,y-4,z-4,width+8,bounds.h+8,depth+8),[]))
						printf("  actual type %d variant %d bounds %S\n",actual.fbtype,actual.fbparam,actual.br);
					throw Exception("Castle fixture was not placed: " .. r.role);
				}
			}
			local placed={role:r.role,parentIndex:r.parentIndex,linkedRegionId:r.linkedRegionId,rotation:rot,
				objectType:r.objectType,objectVariant:r.objectVariant,x:actualBounds.x,y:actualBounds.y,z:actualBounds.z,
				width:actualBounds.w,depth:actualBounds.d,height:actualBounds.h};
			if( r.kind=="castle_door") doors.push(placed);else if(r.kind=="castle_detail")details.push(placed);else fixtures.push(placed);
		}
		// Check the final world, including objects placed early in this pass.
		local expectedObjects=clone fixtures;expectedObjects.extend(doors);expectedObjects.extend(details);
		foreach( expected in expectedObjects){
			if( expected.objectType<0) continue;
			local world=bw.collectFreeBlocks(IRect3D(expected.x,expected.y,expected.z,expected.width,expected.height,expected.depth),[]);
			local found=false;
			foreach( actual in world){
				local b=actual.br;
				if( actual.fbtype==expected.objectType && (actual.fbparam&0x3ff)==expected.objectVariant &&
					b.x==expected.x && b.y==expected.y && b.z==expected.z && b.w==expected.width && b.d==expected.depth && b.h==expected.height){found=true;break;}
			}
			if( !found) throw Exception("Castle object missing from the final world: " .. expected.role);
		}
		foreach( p in portals) for(local dz=0;dz<p.depth;dz++) for(local dx=0;dx<p.width;dx++) for(local dy=0;dy<p.height;dy++)
			if(bw.blockat(p.x+dx,p.y+dy,p.z+dz)!=p.block) throw Exception("Castle door jamb is missing from the final world");
		local report=encodeJSON({seed:assetPlan.seed,castleType:assetPlan.archetype,finalWorldChecked:true,rooms:rooms,fixtures:fixtures,doors:doors,details:details,surfaces:surfaces,portals:portals,clearances:clearances},0,ByteBuffer());
		report.pos=0;FileRef("tmp/mapgen/last_castle_interior.json").save(report);
	}

	function placeSettlementFacilities(bw){
		if(!gendef["settlement"] || !assetPlan || !assetParameters["settlementCivicPlan"]) return;
		local facilities=[],mayors=[],center=null;
		foreach(r in assetPlan.regions){
			if(r.kind=="village_center") center={x0:r.x0,y0:r.y0,x1:r.x1,y1:r.y1};
			if(r.kind=="asset_plot" && r["residentProfile"]=="village_head"){
				local aw=objbw(r.role),entry=constructionAssetDoor(aw);
				local normal=IMat().rotate(r.rotation).transform([(0,0,1),(1,0,0),(0,0,-1),(-1,0,0)][entry.side]);
				if(normal[0]!=0 || normal[2]>=0 || Math.max(aw.w,aw.d)<=12) throw Exception("Mayor residence must be a large south-facing house");
				mayors.push({asset:r.role,x0:r.x0,y0:r.y0,x1:r.x1,y1:r.y1,rotation:r.rotation,doorX:r.doorX,doorY:r.doorY});
			}
			if(r.kind!="settlement_facility") continue;
			local x=r.x0,z=bw.d-1-r.y1,ground=dst[x+z*bw.w]>>>16;
			local fb=FreeBlock.create({fbtype:r.objectType,fbparam:r.objectVariant,pos:[0,0,0],rot:r.rotation}),bounds=IRect3D(fb.br);
			if(bounds.w!=r.x1-r.x0+1 || bounds.d!=r.y1-r.y0+1 || bounds.h!=r.objectHeight) throw Exception("Civic facility dimensions changed: " .. r.role);
			for(local dz=0;dz<bounds.d;dz++)for(local dx=0;dx<bounds.w;dx++){
				if((dst[x+dx+(z+dz)*bw.w]>>>16)!=ground) throw Exception("Civic facility ground is uneven: " .. r.role);
				for(local dy=1;dy<=bounds.h;dy++) if(bw.blockat(x+dx,ground+dy,z+dz)) throw Exception("Civic facility is obstructed: " .. r.role);
			}
			bw.placeFreeBlock(FreeBlock.create({fbtype:r.objectType,fbparam:r.objectVariant,rot:r.rotation,pos:[x-bounds.x,ground+1-bounds.y,z-bounds.z]}));
			facilities.push({role:r.role,objectType:r.objectType,objectVariant:r.objectVariant,rotation:r.rotation,x:x,y:ground+1,z:z,width:bounds.w,depth:bounds.d,height:bounds.h});
		}
		if(!center || !length(facilities) || length(mayors)!=(assetPlan.countryWealth>=2.0?1:0)) throw Exception("Settlement civic centre or mayor residence is incomplete");
		foreach(p in facilities){
			// Query only this reserved plot. Enumerating the whole forest also
			// collects thousands of unrelated tree objects in the native engine.
			local objects=bw.collectFreeBlocks(IRect3D(p.x,p.y,p.z,p.width,p.height,p.depth),[]);
			local found=false;
			foreach(actual in objects){local b=actual.br;
				if(actual.fbtype==p.objectType && (actual.fbparam&0x3ff)==p.objectVariant && b.x==p.x && b.y==p.y && b.z==p.z && b.w==p.width && b.d==p.depth && b.h==p.height){found=true;break;}
			}
			if(!found)throw Exception("Civic facility missing from the final world: " .. p.role);
		}
		local report=encodeJSON({seed:assetPlan.seed,type:assetPlan.type,wealth:assetPlan.countryWealth,center:center,mayors:mayors,facilities:facilities,finalWorldChecked:true},0,ByteBuffer());
		report.pos=0;FileRef("tmp/mapgen/last_settlement_civic.json").save(report);
	}

	function decorateSettlement( bw){
		if( !gendef["settlement"] || !assetPlan) return;
		local w = dst.width, d = dst.height, occupied = Bitmap( w,d);
		local flowerCells=Bitmap( w,d);
		foreach( decoration in assetPlan.regions){
			if( decoration.kind=="settlement_flower" || decoration.kind=="settlement_plant" || decoration.kind=="settlement_crop" || decoration.kind=="settlement_prop" || (decoration.kind=="village_open_space" && decoration.role=="farm")){
				for( local yy=decoration.y0;yy<=decoration.y1;yy++) for( local xx=decoration.x0;xx<=decoration.x1;xx++) flowerCells.set( xx,d-1-yy,1);
			}
		}
		local biomes = assetPlan.biomes, trees = 0, grasses = 0;
		local density=Math.clamp(assetParameters["naturalDecorationDensity"] ?? 3.5,0,100)/100.0;
		local flowers = 0, cacti = 0, benches = 0, crops = 0, shrubs = 0;
		foreach( region in assetPlan.regions){
			if( region.kind!="asset_plot" && region.kind!="asset_wall" && region.kind!="asset_bridge" && region.kind!="village_open_space" && region.kind!="keep" && region.kind!="keep_expansion" && region.kind!="castle_activity" && region.kind!="settlement_facility") continue;
			for( local yy=Math.max(0,region.y0-2);yy<=Math.min(d-1,region.y1+2);yy++) for( local xx=Math.max(0,region.x0-2);xx<=Math.min(w-1,region.x1+2);xx++) flowerCells.set(xx,d-1-yy,1);
		}
		local treeVariant = 66;
		local tree = FreeBlock.create( {fbtype:20, fbparam:treeVariant});
		// The outer forest is terrain, independent of decorative scatter density.
		// Pack complete crowns without the spacing used inside the settlement.
		local denseTrees=0;
		if( assetPlan.settlementSite=="forest"){
			for( local z=0;z<d-2;z++) for( local x=0;x<w-2;x++){
				if( biomes[(d-1-z)*w+x]!=TOWN_TREES || occupied.get(x,z)) continue;
				local y=dst[z*w+x]>>>16,clear=true;
				local variant=rnd.choosea([65,66,67]);
				local fb=FreeBlock.create({fbtype:20,fbparam:variant}),br=fb.br;
				// Tree variants have different footprints. The loop's two-cell
				// margin is not enough for a larger crown near the map edge.
				if( x+br.w>w || z+br.d>d || y+br.h>=bw.h) continue;
				for( local dz=0;dz<br.d && clear;dz++) for( local dx=0;dx<br.w && clear;dx++){
					local i=(z+dz)*w+x+dx;
					if( biomes[(d-1-z-dz)*w+x+dx]!=TOWN_TREES || occupied.get(x+dx,z+dz) || flowerCells.get(x+dx,z+dz) || (dst[i]>>>16)!=y) clear=false;
					for( local dy=1;dy<=br.h && clear;dy++) if(bw.blockat(x+dx,y+dy,z+dz)) clear=false;
				}
				if( clear){
					bw.placeFreeBlock(20,variant,IPos(x-br.x,y+1-br.y,z-br.z,0),0);
					for( local dz=0;dz<br.d;dz++) for( local dx=0;dx<br.w;dx++) occupied.set(x+dx,z+dz,1);
					trees++;denseTrees++;
				}
			}
		}
		local radius = Math.iceil( Math.max( tree.br.w, tree.br.d)/2.0);
		for( local z=radius;z<d-radius;z++) for( local x=radius;x<w-radius;x++){
			local b = biomes[(d-1-z)*w+x], y = dst[z*w+x]>>>16;
			local dry=b==DESERT || assetPlan.settlementSite=="oasis";
			local wooded=b==FOREST || b==TOWN_TREES || assetPlan.settlementSite=="forest";
			local rocky=b==MOUNTAIN || b==EXMOUNTAIN || b==TOWN_CLIFF;
			local natural=b==PLAIN || b==DESERT || b==FOREST || b==TOWN_TREES || rocky;
			if( !natural || flowerCells.get(x,z) || occupied.get(x,z)) continue;
			if( assetPlan["shoreCuts"] && assetPlan.shoreCuts[(d-1-z)*w+x]>0) continue;
			if( (dry || wooded || rocky) && rnd( 1.0)<density){
				treeVariant=dry ? 72 : (rocky ? 17 : 66);
				tree=FreeBlock.create({fbtype:20,fbparam:treeVariant});
				local clear = true;
				for( local dz=-radius;dz<=radius && clear;dz++) for( local dx=-radius;dx<=radius;dx++){
					local i = (z+dz)*w+x+dx;
					if( biomes[(d-1-z-dz)*w+x+dx] != b || occupied.get( x+dx,z+dz) || flowerCells.get(x+dx,z+dz) || (dst[i]>>>16)!=y){ clear=false; break; }
					for( local dy=1;dy<=tree.br.h && clear;dy++) if(bw.blockat(x+dx,y+dy,z+dz)) clear=false;
				}
				if( clear){
					bw.placeFreeBlock( 20,treeVariant,IPos( x-1-tree.br.x,y+1-tree.br.y,z-1-tree.br.z,0),0);
					for( local dz=-radius;dz<=radius;dz++) for( local dx=-radius;dx<=radius;dx++) occupied.set( x+dx,z+dz,1);
					if(dry)cacti++; else if(wooded)trees++; else shrubs++;
				}
			}else if( !dry && !wooded && !rocky && rnd( 1.0)<density){
				if( !bw.blockat( x,y+1,z)){
					bw.placeBlock( (x,y+1,z),11|(rnd.choosea( [2,5,6])<<5),0);
					grasses++;
				}
			}
		}
		foreach( lot in assetPlan.regions){
			if( lot.kind!="village_open_space" || lot.role!="farm") continue;
			for( local yy=lot.y0+2;yy<=lot.y1-2;yy++) for( local xx=lot.x0+2;xx<=lot.x1-2;xx++){
				local z=d-1-yy, y=dst[z*w+xx]>>>16;
				bw.placeBlock( (xx,y,z),blkmap[ROAD],0);
			}
		}
		foreach( decoration in assetPlan.regions){
			if( decoration.kind=="settlement_prop"){
				local role=decoration.role, fbt=role=="bench" ? 4 : 20;
				local variant=({bench:5,cactus:72,palm:68,conifer:66,shade_tree:65,shrub:74,rock:17})[role];
				if( variant==null) continue;
				local fb=FreeBlock.create( {fbtype:fbt,fbparam:variant}), br=fb.br;
				local x=decoration.x0,z=d-1-decoration.y1,y=dst[z*w+x]>>>16;
				local clear=br.w==decoration.x1-decoration.x0+1 && br.d==decoration.y1-decoration.y0+1;
				for( local dz=0;dz<br.d && clear;dz++) for( local dx=0;dx<br.w && clear;dx++){
					if( (dst[(z+dz)*w+x+dx]>>>16)!=y) clear=false;
					for( local dy=1;dy<=br.h && clear;dy++) if( bw.blockat( x+dx,y+dy,z+dz)) clear=false;
				}
				if( clear){
					bw.placeFreeBlock( fbt,variant,IPos( x-br.x,y+1-br.y,z-br.z,0),0);
					if( role=="bench") benches++; else if( role=="cactus") cacti++; else shrubs++;
				}
				continue;
			}
			if( decoration.kind=="settlement_crop"){
				local variant=({leafy_crop:2,tall_crop:6,herb_crop:5})[decoration.role] ?? 2;
				for( local yy=decoration.y0;yy<=decoration.y1;yy++) for( local x=decoration.x0;x<=decoration.x1;x++){
					local z=d-1-yy,y=dst[z*w+x]>>>16;
					bw.placeBlock( (x,y+1,z),blkmap[ROAD],0);
					bw.placeBlock( (x,y+2,z),11|(variant<<5),0);crops++;
				}
				continue;
			}
			if( decoration.kind != "settlement_flower" && decoration.kind!="settlement_plant") continue;
			local x=decoration.x0, z=d-1-decoration.y0, y=dst[z*w+x]>>>16;
			if( bw.blockat( x,y+1,z)) continue;
			local variant=({flower_red:0,flower_yellow:4,flower_white:1,
				coastal_white:1,coastal_blossom:11,river_grass:6,
				lakeside_pink:7,lakeside_white:16,alpine_yellow:17,alpine_red:18,
				mushroom:10,fern:5,waterside_grass:6})[decoration.role] ?? 2;
			bw.placeBlock( (x,y+1,z),11|(variant<<5),0);
			if( decoration.kind=="settlement_flower") flowers++; else shrubs++;
		}
		local report = encodeJSON( {trees:trees, denseTrees:denseTrees, grasses:grasses, flowers:flowers, cacti:cacti, benches:benches, crops:crops, shrubs:shrubs, naturalDensity:density*100, wealth:assetPlan.countryWealth, seed:assetPlan.seed},0,ByteBuffer());
		report.pos=0;
		FileRef( "tmp/mapgen/last_asset_vegetation.json").save( report);
	}

	function toBlockWorld(){
		local w = dst.width, d = dst.height, wd = w*d, rnd = rnd;
		local bw = BlockWorld( w, 128, d);
		//	make blocks
		local r = IRect3D();
		for( local l = 0;l < wd;l ++){
			local x = l%w, z = l/w, y = dst[l]>>>16;
			local blk = dst[l] & 0xffff;
			r.set( x, 0, z, 1, y+1, 1);
			bw.fillBlock( r, blk);					//高さ分塗りつぶし
		}
		local objcache = {};
		//	make objs
		foreach( v in objs){
			local oid = v.objid, vid = blkmap[oid];
			switch( oid){
			case FLOWERS_A:	//	花はブロックを散りばめる。A,B,Cで範囲と数が変わる
			case FLOWERS_B:
			case FLOWERS_C:
			{	//	x,z を中心に半径2,4,6の範囲で、それぞれ 4, 8, 12個の花を散りばめる。
				local r = (oid-FLOWERS_A)*2 + 2.0;
				local n = (oid-FLOWERS_A)*4 + 4;
				local blks = (blkmap[FLOWERS_A], blkmap[FLOWERS_B], blkmap[FLOWERS_C]);
				for( local l = 0;l < n;l ++){
					local b = rnd.choosea( blks);
					if( !b) continue;
					local dd = Math.sqrt( rnd( 1.0)) * r, th = rnd( 0.0, 2.0*3.141592);
					local dx = Math.iround( Math.cos( th) * dd), dz = Math.iround( Math.sin( th) * dd);
					local x = v.x + dx, z = v.z + dz;
					if( x < 0 || x >= w || z < 0 || z >= d) continue;
					local y = dst[x + z*w]>>>16;
					if( (::Block.getFlags( bw.blockat( x, y, z)) & BLK_SOLID) && !bw.blockat( x, y+1, z)){
						bw.placeBlock( (x,y+1,z), b, 0);
					}
				}
				break;
			}
			default:	//	通常はフリーブロックを置くだけ。vidはfbtype|(fbparam<<12)
				local y = dst[v.x + v.z*w]>>>16, size = v["size"]||0;
				if( size >= 2){	//	大きなオブジェクトの場合は周囲の地形に合わせて高さを調整する。
					local r = size/2;
					for( local l = 0;l < 4;l ++){
						local dx = rnd( -r, r), dz = rnd( -r, r);
						local _y = dst[v.x+dx + (v.z-dz)*w]>>>16;
						if( _y < y && _y >= y-4) y = _y;
					}
				}
				// local y = dst[v.x + v.z*w]>>>16;
				if( vid[0]=='M'){
					local aw = objcache[vid] ?? (objcache[vid] <- objbw( vid));
					if( !aw) continue;
					local m = IMat( v.x, y+1, v.z).rotate( v["rot"]).translate( -aw.w/2, 0, -aw.d/2);
					bw.drawWorld( aw, m);
				}else
				if( vid){
					local fb = objcache[vid] ?? (objcache[vid] <- FreeBlock.create( {fbtype:vid&0xfff, fbparam:vid>>>12}));
					bw.placeFreeBlock( vid&0xfff, vid>>>12, IPos( v.x, y+fb.br.h/2+1, v.z, v.rot), 0);
				}
				break;
			}
		}
		savePreviewStage( "construction"); placeConstructionAssets( bw);
		savePreviewStage( "castle_doors"); placeCastleDoors( bw);
		savePreviewStage( "vegetation"); decorateSettlement( bw);
		savePreviewStage( "castle_interior"); placeCastleInterior( bw);
		savePreviewStage( "facilities"); placeSettlementFacilities( bw);
		savePreviewStage( "complete");
		return bw;
	}

	function savePreviewStage( stage){
		try{
			local bb = encodeJSON( {type:gendef.val, seed:seed, stage:stage}, 0, ByteBuffer());
			bb.pos = 0;
			FileRef( "tmp/mapgen/last_preview_stage.json").save( bb);
		}catch( ex){
			printexception( ex);
		}
	}
}
