local srcdir = dirname( callee().getSourceName());

enum MapGenBiomeID
{
	PLAIN = 0,			//	標準的な陸地
	DESERT = 1,			//	砂漠
	FOREST = 2,			//	森林
	MOUNTAIN = 3,		//	通行不能
	EXMOUNTAIN = 4,		//	通行不能
	ROAD = 5,			//	1ブロック幅の道路
	BRIDGE = 6,
	RIVER = 7,			//	通行不能
	LAKE = 8,			//	通行不能
	SEA = 9,			//	通行不能
	//	RENAMED
	FLOOR1 = 0,			//	標準的な床
	FLOOR2 = 1,			//	ひび割れた床や、模様のある床などのバリエーション
	WALL = 3,			//	通行不能
	INNERWALL = 4,		//	壁の内側。上からは真っ黒に見える。
	LAKE1 = 7,			//	
	LAKE2 = 8,			//	
	//	ブロック定義バリエーション
	MOUNTAIN_VAR = 13,		//	山のバリエーション
	// Settlement IDs share the numeric space with world-only variations.
	TOWN_FLOOR = 10,
	TOWN_WOOD_FLOOR = 11,
	TOWN_STONE_FLOOR = 12,
	TOWN_FURNITURE = 13,
	TOWN_PAVEMENT = 14,
	TOWN_SEA = 15,
	TOWN_CLIFF = 16,
	TOWN_TREES = 17,
	CASTLE_WALL_WALK = 18,
};

enum MapGenObjectID
{
    ROCK_S = 20,		//	1x1
    ROCK_M = 21,		//	2x2
    ROCK_L = 22,		//	2x2
    TREE_S = 23,		//	2x2
    TREE_M = 24,		//	3x3
    TREE_L = 25,		//	3x3
    FLOWERS_A = 26,		//	
    FLOWERS_B = 27,		//	
    FLOWERS_C = 28,		//	
    TREES_S = 29,		//	2x2
    TREES_M = 30,		//	3x3
    TREES_L = 31,		//	3x3
	//
	PORTAL_DOOR = 32,		//	ドアのあるポータル
	PORTAL_OPEN = 33,		//	開いたポータル
};

