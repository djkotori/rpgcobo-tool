import VirtualKeyCode;
import ModifiersMask;
import PropertyType;
import RPGPropertyType;

local srcdir = dirname( callee().getSourceName());

local colshplist = [
	{ lbl="BOX", icon="\ue3e0", val=SK_SHAPE_BOX },
	{ lbl="SPHERE", icon="\ue836", val=SK_SHAPE_SPHERE },
	{ lbl="CAPSULE", icon="\ue0d4", val=SK_SHAPE_CAPSULE },
	{ lbl="CYLINDER", icon="\ue71c", val=SK_SHAPE_CYLINDER },
];


////////////////////////////////////////////////////////////////////////////////
//	
//	ResEditorPolyModel : ポリゴンモデル
//	※要素一つ一つが重くなりがちなので、プレビュー画像は読み込み時に作成。pmt保存時に更新とする。abc.pmt => abc.webp。プレビュー作成はPMEditor内のstatic functionに
//	

//	
class ResEditorPolyModel extends ResEditor
{
	static RESSLOTUI = "/ui/resslot3.ui";

	static props = [
		{ pid="name", lbl="$T.lbl_name", type=LANGSTRING, defval=null }
		{ pid="pmt", lbl="$T.lbl_model", type=GRAPHIC, dir="/resource/poly_mdl", restype="poly_mdl", nullable=true, defval=null }
		{ pid="pos", lbl="$T.lbl_position", type=VEC3, range=(-10.0,10.0), q=100, defval=[0,0,0] }
		{ pid="hpb", lbl="$T.lbl_rotation", type=VEC3, range=(-180,180), defval=[0,0,0] }
		{ pid="scale", lbl="$T.lbl_scale", type=SCALAR, range=(0.1,4.0), q=10, defval=1.0, ui="bar" }
		{ pid="colshp",	lbl="$T.lbl_collision",	type=LIST, list=colshplist, defval=SK_SHAPE_BOX },
		{ pid="colsize", lbl="$T.lbl_size", type=VEC3, range=(0.01,10.0),q=100, defval=(0.5,0.5,0.5) },
		
		{ pid="charause", lbl="$T.lbl_charause", type=BOOL, defval=false },
		{ pid="eventuse", lbl="$T.lbl_mapuse", type=BOOL, defval=true },

		{ pid="animap", lbl="$T.lbl_anime", type=ANIMEMAP, defval=[], cnt="cnt6.ui", motlist=@( pl){
			local pmtpath = pl.proplist.ref["selitem"]["data"]["pmt"];
			local pmt = ::getPolygonMeshTree( pmtpath);
			local a = [];	//	{lbl="$T.lbl_none", val=null}
			if( pmt){
				a ... pmt.getMotionIDList().map( @( i) +{ lbl=i, val=i});
			}
			return a;
		}},
		{ pid="memo", lbl="$T.lbl_memo", type=STRING, multiline=true, cnt="cnt6.ui", },
	];

	static titlelbl = "$T.lbl_resedit : $T.side_res_poly_mdl";
	
	function init( path){
		super.init( path);
		resdirpath = ::resroot.file.path .. "/resource/poly_mdl";

		addEventListener( DROPTARGET_EVENT, dndevent);
	}

	function isValidData( d){
		return !!length( d["pmt"]);
	}
	
	function itemSelected( v){
		local d = v.data;
		if( !d) d = v.data = data[v.id] <- { name=""};
		setDefaultProperties( props, d);
		//
		proplist.bindProperties( props);
		proplist.setParameters( d);
		proplist.ref = this;
		preview.setResourceData( v.id, d);
		preview.setAnimations();
	}

	function updateItemView( resid, d){
		super.updateItemView( resid, d);
		if( resid == selitem.id){
			preview.setResourceData( resid, d);
			preview.setAnimations();
		}
	}

	function propevent( e){
		local cmd = e.actioncmd;
		if( cmd.cmd != "prop") return;
		local pid = cmd.prop.pid, val = cmd.val;
		switch( pid){
		case "pmt":	// pmt変更によって、名前、col
			setPmtParamOp( val);
			break;
		default:
			setParamOp( selitem.id, cmd.prop, val);
			break;
		}
	}

	function setPmtParamOp( val){
		local pmt = ::getPolygonMeshTree( val);
		local resid = selitem.id, d = data[resid], self = this;
		local oldpmt = d["pmt"], oldname = d["name"], oldcolsize = d["colsize"];
		local oldpos = d["pos"];
		local bnd = pmt.getBounds();
		local colsize = [bnd.r,bnd.s,bnd.t];
		local changename = !length( d.name);
		local name = val.substring( val.lastIndexOf( "/")+1, val.lastIndexOf( "."));
		//	
		local redo = [@(){
			if( changename) d.name <- {[::lang.code]=name};
			d.pmt <- val;
			d.colsize <- colsize;
			self.updateItemView( resid, d);
		}];
		local undo = [@(){
			if( changename) d.name <- oldname;
			d.pmt <- oldpmt;
			d.colsize <- oldcolsize;
			self.updateItemView( resid, d);
		}];
		submitOp( redo, undo, null);	//	trk無し
		refresh();
	}
	
	function itemAction( e){
	}

	function showItemContextMenu( e){
		local resid = selitem.id, d = data[resid];
		local r = ::getResource( d["pmt"]);
		local cbdata = getClipboard( "resitem");	//	開くたびにクリップボード取得しちゃうけどまーだいじょぶかな
		local menudata = [
			{ id="editpmt", lbl="$T.lbl_edit", icon="\ue745", disable=!r  },
			"-",
			{ id="copy", lbl="$T.menu_edit_copy", icon="\ue14d" },
			{ id="paste", lbl="$T.menu_edit_paste", icon="\ue14f", disable=!isPastable( cbdata)},
			"-",
			{ id="sort", lbl="$T.lbl_idsort", icon="\ue240"},
			{ id="dir", lbl="$T.lbl_openresdir", icon="\ue89e"},
			{ id="import", lbl="$T.lbl_import_3d", icon="\ue675"},
		]
		local ret = MenuPopup.run( menudata);
		switch( ret["id"]){
		case "copy":
			copy();
			break;
		case "paste":
			paste( cbdata);
			break;
		case "editpmt":
			::skstudio.openEditor( r.path);
			break;
		case "sort": return showIDSortDialog();
		case "dir": return skOpenURL( "dir://"..resdirpath);
		case "import":
			local sndpath = skstudio.showFileOpen( { filter=["*.gltf","*.glb","*.vrm"], abspath=true, pathgroup="poly_mdl" });
			if( sndpath){
				local f = FileRef( sndpath);
				showImportGLTF( f, resid);
			}
			break;
		}
	}
	
	function showImportGLTF( f, mdlid){
		local fn = f.name;
		fn = fn.substring( 0, fn.lastIndexOf( ".")) .. ".pmt";
		local pf = FileRef( ::resroot.file.path .. "/resource/poly_mdl/" .. fn);
		if( pf.exists()){
		}
		//	gltf => pmt 変換
		local pmt = null;
		try{
			local ret = PolyImportDialog.run( f, mdlid);
			if( ret){
				pmt = ret.pmt;
				local bb = ObjectOutput.encode( pmt);
				local fn = ret.name .. ".pmt";
				local dir = ::getResource( "/resource/poly_mdl");
				local r0 = dir.getResource( fn);
				if( r0){
					if( !Dialogs.confirm( {msg=tmpl( T.tmpl_import_override, {v=fn})})){
						return;
					}
				}
				local r = dir.create( fn, bb);
				::skstudio.fileview.refreshDir( "/resource/poly_mdl");
				if( ret["setitem"]) setPmtParamOp( r.path);
			}

		}catch( ex){
			printexception( ex);
			::rootview.postErrorEvent( {type="MessagePreview", error=ex, msg = "$T.error_import_mdl: " .. ex.message});
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////
	//	dnd

	function acceptDrag( e){
		return false;
	}
	
	function isDropable( f){
		if( !f) return false;
		local n = f.name; n = n.substring( n.lastIndexOf( ".")+1).toLowerCase();
		return (#["gltf","glb","vrm",]).contains( n);
	}

	function acceptDrop( ds, x, y){
		if( ds instanceof FileDragSource){
			local a = ds.filelist;
			foreach( f in a){
				if( isDropable( f)) return true;
			}
		}
		return false;
	}

	dropto = null;

	function dndevent( e){
		switch( e.id){
		case TARGET_DRAG_ENTER:
		case TARGET_DRAG_OVER:
			local d = previewlist.getViewAt( e.x, e.y);
			if( d != dropto){
				// dropto?.setSelected( false);
				// d?.setSelected( true);
				dropto = d;
			}
			break;
		case TARGET_DRAG_EXIT:
			break;
		case TARGET_DROP:
			skMoveScreen( { flags=MoveScreenFlags.MOVESCREEN_FRONT });	//	ドロップ時にはウィンドウは奥にあるので手前に移動
			// dropto?.setSelected( false);
			local f = e.dragsrc["filelist"][0];
			if( !isDropable( f)) break;
			if( f) showImportGLTF( f, dropto["ref"][2]["mdlid"]);
			break;
		}
	}
}

//	3Dモデルファイルのインポートダイアログ。pmtにして保存する。現在はgltf,glbに対応。
//	※インポートオプションは今のところなし。名前だけ入力欄あり
//	ダイアログ表示時点ですでにgltf->pmtへの変換が行われている。テクスチャは全て埋め込み。
//	
class ResEditorPolyModel.PolyImportDialog extends PropertyEditDialog
{
	canvas = null;			//	CanvasBehavior : プレビューを表示
	infile = null;			//	FileRef : gltf/glb

	pmt = null;				//	コンバート後のpmt。
	data = null;			//	結果。Resourceとかpmtとかが入ってる

	function shown(){
		local btn = view.findChild( "btn_ok");
		btn.setEnabled( false);
		
		canvas = CanvasBehavior( view.findChild( "3DVIEW"), null);
		canvas.view.renderer.setEnvironment( ::RenderSettings.getEnvironment( "pbr_fw"));
		//
		newthread().start( @(){
			suspend();
			local f = proplist.ref;
			local loader = GLTFLoader();
			pmt = loader.loadGLTF( f.load());
			
			local sk3d = SK3DObject();
			sk3d.setSource( pmt);
			sk3d.matdirty = true;
			sk3d.updateMatrix( true);
			canvas.scn.addObject( sk3d);
			canvas.view.repaint();

			btn.setEnabled( true);
		}, this);
	}

	static function run( infile, mdlid){
		local aid;
		for( local l = 0;l < 1000;l ++){
			aid = "MA%03d" % l;
			if( !::conf._resource.map_asset[aid]){ break; }
		}
		local glist = ::conf._resource.map_asset._meta.groups.map( @( v)({ lbl=v.name, icon=v.icon, val=v.id }));
		local propdef = {
			name = "$T.lbl_import_3d",
			props = [
				{ pid="name", lbl="$T.lbl_name", type=STRING, },
				... (mdlid && [{ pid="setitem", lbl=tmpl( T.tmpl_setto_v, {v=mdlid}), type=BOOL}]),
			]
		};
		local d = { name=infile.name.split( ".")[0], setitem=!!mdlid};
		//
		local dlg = this( "/plugin/rpgtools/mapeditor/ui/newassetdialog.ui", propdef, d, infile);
		dlg.show();
		if( dlg.ret){
			return { ...dlg.data, pmt=dlg.pmt };
		}
	}
}

//	
//	
//	
class ResEditorPolyModel.ResPreview
{
	view = null;
	editor = null;
	efxid = null;

	canvas = null;		//	CanvasBehavior
	envmenu = null;		//	MenuBehavior
	animenu = null;		//	MenuBehavior
	playbtn = null;		//	GPUIButton
	pntchk = null;
	loopchk = null;

	envlist = null;

	sk3d = null;
	skcol = null;

	constructor( v, e){
		view = v;
		editor = e;
		canvas = CanvasBehavior( v.findChild( "3d"), v);
		envmenu = MenuBehavior( v.findChild( "envmenu"), envlist=getRenderSettingMenuList( false), false);	//	no sync
		setRenderSettingID( "pbr_fw");
		animenu = MenuBehavior( v.findChild( "animenu"));
		
		playbtn = v.findChild( "playbtn");
		playbtn.setVisible( true);
		v.findChild( "datamenu").setVisible( false);
		v.addEventListener( ACTION_EVENT, actionevent);
		loopchk = v.findChild( "loopchk");

		local scn = canvas.scn, b3world = scn.getB3World();
		skcol = SK3DCollisionPreview( b3world);
		scn.addObject( skcol);
		pntchk = v.findChild( "pntchk");
		pntchk.setSelected( true);
	}

	function setResourceData( id, val){
		if( sk3d) canvas.scn.removeObject( sk3d);
		sk3d = RPG3DObject.create3DObject( {mdl=val});
		sk3d.setDir( Math.PI);
		if( !skcol.scn){
			canvas.scn.addObject( skcol);	//	clearされちゃってたら追加
			skcol?.setVisible( pntchk.isSelected());
		}
		canvas.scn.addObject( sk3d);
		canvas.view.repaint();
	}

	function setAnimations(){
		local animelist = sk3d["animelist"];
		local selid = animenu.selitem["id"] || animelist[0]["id"];
		if( animelist){
			local menudata = animelist.map( @( v){
				return { lbl = v.id, icon = v["icon"]||"\uf2c0", id = v.id, val = v }
			});
			animenu.setMenu( menudata);
			animenu.selectItem( @( v) v.id==selid);
		}else{
			animenu.setMenu( [{lbl="$T.lbl_none", val = null}]);
		}
	}

	function getEnvItem( rsetid){
		return envlist.find( @( v) v["id"]==rsetid);
	}

	function setRenderSettingID( rsetid){
		local v = getEnvItem( rsetid);
		envmenu.selectItem( @( v) v["id"]==rsetid);
		canvas.view.renderer.setEnvironment( ::RenderSettings.getEnvironment( rsetid));
	}
	
	function actionevent( e){
		switch( e.src["name"]){
		case "playbtn":
			local v = animenu.selitem.val;
			if( sk3d && v) sk3d.tanime( v);
			break;
		case "stopbtn":
			if( sk3d) sk3d.tanime( { st=0});
			break;
		case "pntchk":
			if( sk3d) skcol?.setVisible( pntchk.isSelected());
		case "animenu":
			local v = animenu.selitem.val;
			if( sk3d && v) sk3d.tanime( v);
			break;
		case "rbtn":
		case "lbtn":
			local i = animenu.menuitems.indexOf( animenu.selitem);
			i = Math.clamp( i+(e.src.name=="rbtn"?1:-1), 0, length( animenu.menuitems)-1);
			local v = animenu.menuitems[i];
			animenu.selectItem( v);
			if( sk3d && v.val) sk3d.tanime( v.val);
			break;
		case "envmenu":
			local rsetid = e.actioncmd["id"];
			if( rsetid){
				setRenderSettingID( rsetid);
			}
			break;
		}
	}
}
