class PMShapePanel
{
	// static baseprops = [
	// 	{ pid = "name", lbl = "$T.lbl_name", type = STRING, },
	// 	{ pid="G1", lbl="", type=HEADER, cnt="header0.ui"},
	// ];

	editor = null;
	view = null;

	keymenu = null;			//	MenuBehavior
	proplist = null;		//	GPUIListView

	pm = null;
	selkey = null;			//	

	wmap = null;			//	{ keyname, weight }

	
	constructor( v, e){
		view = v;
		editor = e;
		v.addEventListener( ACTION_EVENT, actionevent);
		proplist = PropertyListBehavior( v.findChild( "proplist"));
		proplist.listview.addEventListener( ACTION_EVENT, propevent);
		proplist.listview.addEventListener( ITEM_EVENT, propevent);
		proplist.ref = e;
		keymenu = MenuBehavior( v.findChild( "mtlmenu"));
	}
	
	function setPM( p){
		pm = p;
		local pms = pm["ref"];
		if( pms["shapekeys"]){
			wmap = {};
			foreach( k, v in pms["shapekeys"]["keymap"]) wmap[k] <- 0.0;
			printf( "wmap %S\n", encodeJSON( wmap));
		}else{
			wmap = null;
		}
		refresh();
	}

	function refresh(){
		local pms = pm["ref"];
		if( !pms["shapekeys"]){
			keymenu.setMenu( [{lbl="$T.lbl_none", val=null}]);
			proplist.bindProperties( []);
			return;
		}
		local _idx = selkey["val"] ?? null;
		local sk = pms["shapekeys"], keymap = sk.keymap;	//	keymapはインデックスを名前でマップしている
		local keylist = Table.map( keymap, @( v, k) +{ lbl=k, val=v }).sort( @( v) v.val);
		keymenu.setMenu( [{lbl="$T.lbl_nosel", val=null}] ... keylist);
		local item = keylist.find( @( v) v.val==_idx) || keymenu.menuitems[0];
		selkey = item;
		keymenu.selectItem( item);
		//	props
		local props = keylist.map( @( v){
			return {
				pid = v.lbl, lbl = v.lbl, type = SCALAR, range=(0.0, 1.0), q=100, ui="bar", dynamic = true,
			};
		});
		proplist.bindProperties( props);
		proplist.setParameters( wmap);
	}

	function actionevent( e){
	}

	function propevent( e){
		local cmd = e.actioncmd;
		if( cmd["cmd"] != "prop") return;
		local prop = cmd.prop, pid = prop.pid;
		// printf( "!!!!!!!!!!!!!!!!!!!! %S %S\n", pid, cmd.val);
		wmap[pid] <- cmd.val;
		pm.shapetarget.assign( wmap);
	}
}
